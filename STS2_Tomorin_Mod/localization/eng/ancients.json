{
  "THE_ARCHITECT.talk.STS2_TOMORIN_MOD-TOMORIN.0-0r.ancient": "You've come again.",
  "THE_ARCHITECT.talk.STS2_TOMORIN_MOD-TOMORIN.0-0r.char": "I will... return to everyone!",
  "THE_ARCHITECT.talk.STS2_TOMORIN_MOD-TOMORIN.0-0r.next": "Continue.",
  "THE_ARCHITECT.talk.STS2_TOMORIN_MOD-TOMORIN.0-1r.ancient": "I told you before. There is no road here that leads you back.",
  "THE_ARCHITECT.talk.STS2_TOMORIN_MOD-TOMORIN.0-attack": "She won't stop.",

  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.title": "The Giraffe",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.epithet": "Seeker of the Stage of Fate",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.ANY.0-0r.ancient": "Let me see it: the unpredictable stage of fate.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.firstVisitEver.0-0.ancient": "Another participant.\nI understand.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.0-0.ancient": "Good evening, Tomori Takamatsu.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-0.ancient": "Good evening, Tomori Takamatsu.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-0.next": "Answer",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-1.char": "The Giraffe...",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-1.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-2.ancient": "I understand.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-2.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-3.ancient": "A Live is an enchanting stage where microphones and instruments intertwine.\nThe Spire responds to the brilliance of band girls.\nThe path to Top Star opens before the one who performs the most dazzling Live.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-3.next": "Answer",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-4.char": "Top Star? I don't want to become a Top Star.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-4.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-5.ancient": "But what if it could take you to any Live you wished to stand upon?",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-5.next": "Answer",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-6.char": "Any... Live?",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-6.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.1-7.ancient": "I understand.",

  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-visit": "2",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-0.ancient": "Congratulations, Tomori Takamatsu.\nAfter crossing countless Lives, the stage of fate is now before you.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-0.next": "Answer",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-1.char": "The stage of fate...",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-1.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-2.ancient": "You have one too, do you not? A dazzling stage.\nA radiant stage you yearn for, yet cannot reach.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-2.next": "Answer",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-3.char": "Dazzling?",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-3.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.2-4.ancient": "I understand.",

  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-visit": "3",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-0.ancient": "We meet again, Tomori Takamatsu.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-0.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-1.ancient": "How many times has it been now? What kind of stage do you wish to stand upon this time?",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-1.next": "Ask",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-2.char": "Why are you doing all this?",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-2.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-3.ancient": "The instant a band girl becomes Top Star, a chemical reaction fuses miracle and brilliance.\nAn everlasting radiance. A momentary blaze.\nA stage of fate no one can predict.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-3.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-4.ancient": "That is what I wish to see.",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-4.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-5.char": "...",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-5.next": "Continue",
  "STS2_TOMORIN_MOD-GIRAFFE_ANCIENT.talk.STS2_TOMORIN_MOD-TOMORIN.3-6.ancient": "I understand."
}
