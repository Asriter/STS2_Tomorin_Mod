using STS2_Tomorin_Mod.Cards;
using STS2_Tomorin_Mod.Enemy.CardIntents;
using STS2_Tomorin_Mod.Enemy.CardIntents.Test;
using MegaCrit.Sts2.Core.Entities.Cards;
using MegaCrit.Sts2.Core.Models;
using Xunit;

namespace CardIntentHarness;

/// <summary>
/// 验证行动指标选择、槽位抽取、双软锁与候选事务隔离。
/// </summary>
public sealed class ActionPlannerTests
{
    /// <summary>
    /// 验证后续回合指标排除上次结果，而首回合保留完整指标候选集。
    /// </summary>
    [Fact]
    public void MetricSelectionUsesFullFirstTurnSetThenExcludesLastMetric()
    {
        CardIntentTestRules rules = CardIntentTestRules.Default;
        HashSet<EnemyActionMetric> firstTurnMetrics = [];
        for (int metricIndex = 0; metricIndex < rules.Recipes.Count; metricIndex++)
        {
            EnemyCardCombatState independentFirstTurn = CreateState(
                $"METRIC_FIRST_{metricIndex}",
                CreateCardsForRecipes(rules));
            RecordingRandomSource indexedRandom = new(
                new[] { metricIndex }.Concat(Enumerable.Repeat(0, rules.MaxCandidateAttempts * 8)));
            EnemyActionMetricPlanner indexedPlanner = new(rules, new EnemyCardScoreCalculator());
            firstTurnMetrics.Add(indexedPlanner.Prepare(
                independentFirstTurn,
                new EnemyPlanningContext(indexedRandom)).Metric);
        }

        EnemyCardCombatState firstTurn = CreateState("METRIC_FIRST", CreateCardsForRecipes(rules));
        RecordingRandomSource firstRandom = new(Enumerable.Repeat(0, rules.MaxCandidateAttempts * 8));
        EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());

        PreparedEnemyCardAction first = planner.Prepare(firstTurn, new EnemyPlanningContext(firstRandom));
        EnemyActionMetric previous = first.Metric;
        ResetSelectedCardsToDraw(firstTurn);
        RecordingRandomSource nextRandom = new(Enumerable.Repeat(0, rules.MaxCandidateAttempts * 8));
        PreparedEnemyCardAction next = planner.Prepare(firstTurn, new EnemyPlanningContext(nextRandom));

        Assert.Equal(rules.Recipes.Keys.Order(), firstTurnMetrics.Order());
        Assert.NotEqual(previous, next.Metric);
    }

    /// <summary>
    /// 验证配方按左到右槽位选牌，多 Tag 实例不会重复占用，随机槽位也不额外补牌。
    /// </summary>
    [Fact]
    public void RecipeFillsSlotsLeftToRightWithoutReusingAnInstance()
    {
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Gain,
            [EnemyCardTag.Attack, EnemyCardTag.Defense, null]);
        CardIntentTestRules rules = CardIntentTestRules.ForTesting(recipe);
        BaseEnemyCard multiTag = CreateCard("LEFT_MULTI", EnemyCardTag.Attack | EnemyCardTag.Defense);
        BaseEnemyCard defense = CreateCard("LEFT_DEFENSE", EnemyCardTag.Defense);
        BaseEnemyCard fallback = CreateCard("LEFT_FALLBACK", EnemyCardTag.Ability);
        EnemyCardCombatState state = CreateState("LEFT_TO_RIGHT", [multiTag, defense, fallback]);
        EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, recipe.Slots.Count * 4))));

        Assert.Equal(recipe.Slots.Count, action.MetricCards.Count);
        Assert.Equal(action.MetricCards.Count, action.MetricCards.Select(card => card.InstanceKey).Distinct().Count());
        Assert.Equal(multiTag.CardId, action.MetricCards[0].CardId);
        Assert.Equal(defense.CardId, action.MetricCards[1].CardId);
        Assert.Equal(fallback.CardId, action.MetricCards[2].CardId);
    }

    /// <summary>
    /// 验证被软锁拒绝的候选不修改牌区，但已消费的随机序列不会回滚。
    /// </summary>
    [Fact]
    public void RejectedCandidateOnlyAdvancesRandomAndAcceptedCandidateCommits()
    {
        EnemyActionRecipe recipe = new(EnemyActionMetric.Attack, [null]);
        CardIntentTestRules rules = CardIntentTestRules.ForTesting(recipe);
        BaseEnemyCard rejected = CreateCard(
            "LOCK_REJECTED",
            EnemyCardTag.Attack,
            new EnemyCardScoreProfile(attack: rules.AttackLock + decimal.One));
        BaseEnemyCard accepted = CreateCard(
            "LOCK_ACCEPTED",
            EnemyCardTag.Attack,
            new EnemyCardScoreProfile(attack: rules.AttackLock));
        EnemyCardCombatState state = CreateState("LOCK_TRANSACTION", [rejected, accepted]);
        EnemyCardInstanceKey[] originalDraw = state.DrawPile.Select(card => card.InstanceKey).ToArray();
        RecordingRandomSource random = new([0, 0, 0, 1]);
        EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());

        PreparedEnemyCardAction action = planner.Prepare(state, new EnemyPlanningContext(random));

        Assert.Equal(accepted.CardId, Assert.Single(action.MetricCards).CardId);
        Assert.DoesNotContain(state.CurrentCards, card => card.CardId == rejected.CardId);
        Assert.Contains(state.DrawPile, card => card.CardId == rejected.CardId);
        Assert.True(action.SoftLockDiagnostic.RejectedCandidateCount > 0);
        Assert.True(random.CallCount > recipe.Slots.Count);
        Assert.Equal(originalDraw.Length - action.MetricCards.Count, state.DrawPile.Count);
    }

    /// <summary>
    /// 验证非空抽牌堆没有匹配 Tag 时随机兜底，且不会提前回洗弃牌堆中的匹配牌。
    /// </summary>
    [Fact]
    public void NonEmptyDrawUsesFallbackWithoutPrematurelyReshufflingMatchingDiscard()
    {
        EnemyActionRecipe recipe = new(EnemyActionMetric.Attack, [EnemyCardTag.Attack]);
        CardIntentTestRules rules = CardIntentTestRules.ForTesting(recipe);
        BaseEnemyCard fallback = CreateCard("FALLBACK_DRAW", EnemyCardTag.Ability);
        BaseEnemyCard matching = CreateCard("FALLBACK_DISCARD", EnemyCardTag.Attack);
        EnemyCardCombatState state = CreateState("FALLBACK_NO_RESHUFFLE", [fallback, matching]);
        BaseEnemyCard authoritativeMatching = state.DrawPile.Single(card => card.CardId == matching.CardId);
        state.MoveCard(authoritativeMatching.InstanceKey, EnemyCardZone.Discard);
        EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, recipe.Slots.Count * 4))));

        Assert.Equal(fallback.CardId, Assert.Single(action.MetricCards).CardId);
        Assert.Contains(state.DiscardPile, card => card.CardId == matching.CardId);
    }

    /// <summary>
    /// 验证旧式 Tag、新式 Tag rule 与随机固定槽在牌数不足时都属于结构不完整。
    /// </summary>
    [Theory]
    [InlineData(0)]
    [InlineData(1)]
    [InlineData(2)]
    public void EveryFixedRecipeSlotIsMandatoryWhenDeckRunsOut(int recipeStyle)
    {
        EnemyActionRecipe recipe = recipeStyle switch
        {
            0 => new EnemyActionRecipe(
                EnemyActionMetric.Attack,
                [EnemyCardTag.Attack, EnemyCardTag.Defense]),
            1 => new EnemyActionRecipe(
                EnemyActionMetric.Attack,
                [new EnemyActionSlotRule(EnemyCardTag.Attack), new EnemyActionSlotRule(EnemyCardTag.Defense)],
                EnemyCandidateConstraints.Unrestricted),
            2 => new EnemyActionRecipe(EnemyActionMetric.Attack, [null, null]),
            _ => throw new ArgumentOutOfRangeException(nameof(recipeStyle))
        };
        CardIntentTestRules rules = CardIntentTestRules.ForTesting(recipe);
        BaseEnemyCard onlyCard = CreateCard($"MANDATORY_ONLY_{recipeStyle}", EnemyCardTag.Attack);
        EnemyCardCombatState state = CreateState($"MANDATORY_{recipeStyle}", [onlyCard]);
        state.MoveCard(state.DrawPile[0].InstanceKey, EnemyCardZone.Discard);
        EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());

        Assert.Throws<EnemyCandidatePlanningException>(() => planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, recipe.Slots.Count * 8)))));

        Assert.Empty(state.CurrentCards);
        Assert.Contains(state.DiscardPile, card => card.CardId == onlyCard.CardId);
    }

    /// <summary>
    /// 验证达到规则配置的最后候选时强制提交，并且评分忽略重放标记。
    /// </summary>
    [Fact]
    public void FinalCandidateIsForcedAndScoringIgnoresReplayCount()
    {
        EnemyActionRecipe recipe = new(EnemyActionMetric.Attack, [EnemyCardTag.Attack]);
        CardIntentTestRules rules = CardIntentTestRules.ForTesting(recipe);
        BaseEnemyCard overLock = CreateCard(
            "LOCK_FORCED",
            EnemyCardTag.Attack,
            new EnemyCardScoreProfile(attack: rules.AttackLock + decimal.One));
        for (int index = 0; index < rules.MaxCandidateAttempts; index++)
        {
            overLock.IncreaseReplayCount();
        }

        EnemyCardCombatState state = CreateState("LOCK_FORCED", [overLock]);
        EnemyCardScoreCalculator calculator = new();
        EnemyCardScore scoreBefore = calculator.Calculate([overLock], EnemyCardScoreContext.Identity);
        overLock.IncreaseReplayCount();
        EnemyCardScore scoreAfter = calculator.Calculate([overLock], EnemyCardScoreContext.Identity);
        EnemyActionMetricPlanner planner = new(rules, calculator);

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, rules.MaxCandidateAttempts * 4))));

        Assert.Equal(scoreBefore, scoreAfter);
        Assert.True(action.SoftLockDiagnostic.WasForcedByAttemptLimit);
        Assert.Equal(rules.MaxCandidateAttempts, action.SoftLockDiagnostic.CandidateAttemptCount);
        Assert.Equal(overLock.CardId, Assert.Single(action.MetricCards).CardId);
    }

    /// <summary>
    /// 验证总评分锁可在攻击锁未触发时独立拒绝候选，并在最终次数强制提交。
    /// </summary>
    [Fact]
    public void TotalScoreLockOperatesIndependentlyFromAttackLock()
    {
        EnemyActionRecipe recipe = new(EnemyActionMetric.Gain, [EnemyCardTag.Defense]);
        CardIntentTestRules rules = CardIntentTestRules.ForTesting(recipe);
        BaseEnemyCard scoreOnly = CreateCard(
            "TOTAL_LOCK_ONLY",
            EnemyCardTag.Defense,
            new EnemyCardScoreProfile(
                block: (rules.TotalScoreLock + decimal.One) / EnemyCardScoreWeights.Block));
        EnemyCardCombatState state = CreateState("TOTAL_LOCK_ONLY", [scoreOnly]);
        EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, rules.MaxCandidateAttempts * 4))));

        Assert.True(action.SoftLockDiagnostic.Score.Attack <= rules.AttackLock);
        Assert.True(action.SoftLockDiagnostic.Score.Total > rules.TotalScoreLock);
        Assert.True(action.SoftLockDiagnostic.WasForcedByAttemptLimit);
    }

    /// <summary>
    /// 验证真实规划器先按 Metric 排序，再以半开权重桶选择，并在排除上次指标后重算随机上界。
    /// </summary>
    [Fact]
    public void WeightedRulesSortRecipesUseHalfOpenBucketsAndRenormalizeAfterLastMetric()
    {
        EnemyActionRecipe gain = new(EnemyActionMetric.Gain, [null]);
        EnemyActionRecipe attack = new(EnemyActionMetric.Attack, [null]);
        EnemyCardPlanningRules rules = new(
            new EnemySoftLockLimits(999m, 999m),
            new EnemySoftLockLimits(999m, 999m),
            maxCandidateAttempts: 1,
            stepLimit: 256,
            recipes:
            [
                new EnemyWeightedActionRecipe(attack, 3),
                new EnemyWeightedActionRecipe(gain, 1)
            ]);
        EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());

        EnemyCardCombatState zeroBucketState = CreateState(
            "WEIGHT_ZERO_BUCKET",
            [CreateCard("WEIGHT_ZERO_BUCKET", EnemyCardTag.Attack)]);
        RecordingRandomSource zeroBucketRandom = new([0, 0]);

        PreparedEnemyCardAction zeroBucket = planner.Prepare(
            zeroBucketState,
            new EnemyPlanningContext(zeroBucketRandom));

        Assert.Equal(EnemyActionMetric.Gain, zeroBucket.Metric);
        Assert.Equal(4, zeroBucketRandom.UpperBounds[0]);

        EnemyCardCombatState oneBucketState = CreateState(
            "WEIGHT_ONE_BUCKET",
            [CreateCard("WEIGHT_ONE_BUCKET", EnemyCardTag.Attack)]);
        RecordingRandomSource oneBucketRandom = new([1, 0]);

        PreparedEnemyCardAction oneBucket = planner.Prepare(
            oneBucketState,
            new EnemyPlanningContext(oneBucketRandom));

        Assert.Equal(EnemyActionMetric.Attack, oneBucket.Metric);
        Assert.Equal(4, oneBucketRandom.UpperBounds[0]);

        EnemyCardCombatState lastBucketState = CreateState(
            "WEIGHT_LAST_BUCKET",
            [CreateCard("WEIGHT_LAST_BUCKET", EnemyCardTag.Attack)]);
        RecordingRandomSource lastBucketRandom = new([3, 0]);

        PreparedEnemyCardAction lastBucket = planner.Prepare(
            lastBucketState,
            new EnemyPlanningContext(lastBucketRandom));

        Assert.Equal(EnemyActionMetric.Attack, lastBucket.Metric);
        Assert.Equal(4, lastBucketRandom.UpperBounds[0]);

        ResetSelectedCardsToDraw(lastBucketState);
        RecordingRandomSource renormalizedRandom = new([0, 0]);

        PreparedEnemyCardAction afterAttack = planner.Prepare(
            lastBucketState,
            new EnemyPlanningContext(renormalizedRandom));

        Assert.Equal(EnemyActionMetric.Gain, afterAttack.Metric);
        Assert.Equal(1, renormalizedRandom.UpperBounds[0]);
    }

    /// <summary>
    /// 验证 Compose 数量约束同时过滤正常 Tag 命中与无 Tag 命中时的随机兜底。
    /// </summary>
    [Theory]
    [InlineData(EnemyCardTag.Attack)]
    [InlineData(EnemyCardTag.Defense)]
    public void ComposeConstraintAppliesToMatchedAndFallbackCandidates(EnemyCardTag requiredTag)
    {
        BaseEnemyCard composeAttack = CreateComposeCard("CONSTRAINT_COMPOSE", CardType.Attack);
        BaseEnemyCard ordinaryAttack = CreateCard("CONSTRAINT_ORDINARY", EnemyCardTag.Attack);
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Pressure,
            [new EnemyActionSlotRule(requiredTag)],
            new EnemyCandidateConstraints(
                MaxComposeSources: 0,
                MaxImmediateAttackComposeSources: 0,
                MaxComposeSourcesProducingImmediateAttack: 0));
        EnemyCardCombatState state = CreateState(
            $"CONSTRAINT_{requiredTag.ToString().ToUpperInvariant()}",
            [composeAttack, ordinaryAttack]);
        EnemyActionMetricPlanner planner = new(
            CreateRules(recipe),
            new EnemyCardScoreCalculator());

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource([0, 0])));

        Assert.Equal(ordinaryAttack.CardId, Assert.Single(action.MetricCards).CardId);
    }

    /// <summary>
    /// 验证 DefinitionId 谓词在 Tag 匹配失败后的随机兜底中仍然是硬资格条件。
    /// </summary>
    [Fact]
    public void AllowedDefinitionIdsRemainMandatoryForRandomFallback()
    {
        BaseEnemyCard disallowed = CreateCard("ALLOWED_DISALLOWED", EnemyCardTag.Attack);
        BaseEnemyCard allowed = CreateCard("ALLOWED_ONLY", EnemyCardTag.Attack);
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Growth,
            [new EnemyActionSlotRule(
                EnemyCardTag.Defense,
                new HashSet<EnemyCardId> { allowed.CardId })],
            new EnemyCandidateConstraints(int.MaxValue, int.MaxValue, int.MaxValue));
        EnemyCardCombatState state = CreateState("ALLOWED_FALLBACK", [disallowed, allowed]);
        EnemyActionMetricPlanner planner = new(CreateRules(recipe), new EnemyCardScoreCalculator());

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource([0, 0])));

        Assert.Equal(allowed.CardId, Assert.Single(action.MetricCards).CardId);
    }

    /// <summary>
    /// 验证“对应素材”槽直接读取此前已选 Compose 来源的请求，而不是复用一个近似 Tag。
    /// </summary>
    [Fact]
    public void ComposeMaterialSlotUsesTheSelectedSourcesMaterialRequest()
    {
        BaseEnemyCard composeSource = CreateComposeCard("MATERIAL_SOURCE", CardType.Attack);
        BaseEnemyCard wrongSkill = new HarnessEnemyCard(new EnemyCardDefinition(
            new EnemyCardId("STS2_TOMORIN_MOD:PLANNER_MATERIAL_WRONG_SKILL"),
            new DefendTomorin(),
            EnemyCardTag.Gain,
            EnemyCardScoreProfile.Zero));
        BaseEnemyCard attackMaterial = CreateCard("MATERIAL_ATTACK", EnemyCardTag.Attack);
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Compose,
            [
                new EnemyActionSlotRule(EnemyCardTag.Compose),
                new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true)
            ],
            new EnemyCandidateConstraints(1, 1, 1));
        EnemyCardCombatState state = CreateState(
            "MATERIAL_REQUEST",
            [composeSource, wrongSkill, attackMaterial]);
        EnemyActionMetricPlanner planner = new(CreateRules(recipe), new EnemyCardScoreCalculator());

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource([0, 0, 0])));

        Assert.Equal(
            [composeSource.CardId, attackMaterial.CardId],
            action.MetricCards.Select(card => card.CardId));
    }

    /// <summary>
    /// 多来源、多 request 与 Count 必须按来源/request/requirement 顺序展开；素材牌自身的 Compose request 不得劫持队列。
    /// </summary>
    [Fact]
    public void ComposeMaterialBindingIsOrderedCountAwareAndIgnoresMaterialCardsAsSources()
    {
        BaseEnemyCard firstSource = CreateDefinedCard(
            "ORDER_SOURCE_FIRST",
            new StrikeTomorin(),
            EnemyCardTag.Compose,
            [
                EnemyMaterialRequest.Compose(CardType.Attack, 2),
                EnemyMaterialRequest.Compose(CardType.Skill, 1)
            ]);
        BaseEnemyCard secondSource = CreateDefinedCard(
            "ORDER_SOURCE_SECOND",
            new DefendTomorin(),
            EnemyCardTag.Compose,
            [EnemyMaterialRequest.Compose(CardType.Attack, 1)]);
        BaseEnemyCard firstAttack = CreateDefinedCard(
            "ORDER_ATTACK_MATERIAL_WITH_REQUEST",
            new StrikeTomorin(),
            EnemyCardTag.Compose,
            [EnemyMaterialRequest.Compose(CardType.Skill, 1)]);
        BaseEnemyCard secondAttack = CreateDefinedCard(
            "ORDER_ATTACK_MATERIAL_SECOND",
            new StrikeTomorin(),
            EnemyCardTag.None);
        BaseEnemyCard skill = CreateDefinedCard(
            "ORDER_SKILL_MATERIAL",
            new DefendTomorin(),
            EnemyCardTag.Attack);
        BaseEnemyCard finalAttack = CreateDefinedCard(
            "ORDER_ATTACK_MATERIAL_FINAL",
            new StrikeTomorin(),
            EnemyCardTag.None);
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Compose,
            [
                new EnemyActionSlotRule(null, new HashSet<EnemyCardId> { firstSource.CardId }),
                new EnemyActionSlotRule(null, new HashSet<EnemyCardId> { secondSource.CardId }),
                new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true),
                new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true),
                new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true),
                new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true)
            ],
            EnemyCandidateConstraints.Unrestricted);
        EnemyCardCombatState state = CreateState(
            "ORDERED_MATERIAL_BINDING",
            [firstSource, secondSource, firstAttack, secondAttack, skill, finalAttack]);
        EnemyActionMetricPlanner planner = new(CreateRules(recipe), new());

        PreparedEnemyCardAction action = planner.Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, 16))));

        Assert.Equal(
            [
                firstSource.CardId,
                secondSource.CardId,
                firstAttack.CardId,
                secondAttack.CardId,
                skill.CardId,
                finalAttack.CardId
            ],
            action.MetricCards.Select(card => card.CardId));
    }

    /// <summary>全部显式槽位已填满但 Compose request 仍有未绑定单位时，候选仍然不完整。</summary>
    [Fact]
    public void ComposeCandidateIsIncompleteWhenExpandedRequirementUnitsRemain()
    {
        BaseEnemyCard source = CreateDefinedCard(
            "PENDING_SOURCE",
            new StrikeTomorin(),
            EnemyCardTag.Compose,
            [EnemyMaterialRequest.Compose(CardType.Attack, 2)]);
        BaseEnemyCard oneMaterial = CreateCard("PENDING_ONE_MATERIAL", EnemyCardTag.Attack);
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Compose,
            [
                new EnemyActionSlotRule(EnemyCardTag.Compose),
                new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true)
            ],
            EnemyCandidateConstraints.Unrestricted);
        EnemyCardCombatState state = CreateState("PENDING_MATERIAL_UNIT", [source, oneMaterial]);

        Assert.Throws<EnemyCandidatePlanningException>(() => new EnemyActionMetricPlanner(CreateRules(recipe), new())
            .Prepare(state, new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, 8)))));
    }

    /// <summary>没有此前 Compose request 的素材槽必须直接判为结构不完整。</summary>
    [Fact]
    public void ComposeMaterialSlotWithoutPendingRequestIsIncomplete()
    {
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Compose,
            [new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true)],
            EnemyCandidateConstraints.Unrestricted);
        EnemyCardCombatState state = CreateState(
            "MATERIAL_WITHOUT_SOURCE",
            [CreateCard("MATERIAL_WITHOUT_SOURCE", EnemyCardTag.Attack)]);

        Assert.Throws<EnemyCandidatePlanningException>(() => new EnemyActionMetricPlanner(CreateRules(recipe), new())
            .Prepare(state, new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, 8)))));
    }

    /// <summary>即时攻击 Compose 来源上限读取 CardModel.Type，而不是可故意不一致的软 Attack Tag。</summary>
    [Fact]
    public void ImmediateAttackComposeConstraintUsesCardTypeInsteadOfAttackTag()
    {
        BaseEnemyCard skillWithAttackTag = CreateDefinedCard(
            "TYPE_SKILL_TAG_ATTACK",
            new DefendTomorin(),
            EnemyCardTag.Attack | EnemyCardTag.Compose,
            [EnemyMaterialRequest.Compose(CardType.Attack, 1)]);
        BaseEnemyCard attackWithoutAttackTag = CreateDefinedCard(
            "TYPE_ATTACK_NO_ATTACK_TAG",
            new StrikeTomorin(),
            EnemyCardTag.Compose,
            [EnemyMaterialRequest.Compose(CardType.Attack, 1)]);
        BaseEnemyCard ordinaryAttackMaterial = CreateDefinedCard(
            "TYPE_ORDINARY_ATTACK_MATERIAL",
            new StrikeTomorin(),
            EnemyCardTag.None);
        EnemyActionRecipe recipe = new(
            EnemyActionMetric.Compose,
            [
                new EnemyActionSlotRule(EnemyCardTag.Compose),
                new EnemyActionSlotRule(null, MustMatchSelectedComposeMaterial: true)
            ],
            new EnemyCandidateConstraints(2, 0, 2));
        EnemyCardCombatState state = CreateState(
            "CARD_TYPE_CONSTRAINT",
            [skillWithAttackTag, attackWithoutAttackTag, ordinaryAttackMaterial]);

        PreparedEnemyCardAction action = new EnemyActionMetricPlanner(CreateRules(recipe), new()).Prepare(
            state,
            new EnemyPlanningContext(new RecordingRandomSource(Enumerable.Repeat(0, 8))));

        Assert.Equal(skillWithAttackTag.CardId, action.MetricCards[0].CardId);
        Assert.Equal(ordinaryAttackMaterial.CardId, action.MetricCards[1].CardId);
        Assert.Contains(state.DrawPile, card => card.CardId == attackWithoutAttackTag.CardId);
    }

    /// <summary>
    /// 根据规则配方创建足以覆盖全部 Tag 槽位的牌组。
    /// </summary>
    /// <param name="rules">提供配方全集的规则对象。</param>
    /// <returns>按配方遍历顺序创建的实例集合。</returns>
    private static IReadOnlyList<BaseEnemyCard> CreateCardsForRecipes(CardIntentTestRules rules) =>
        rules.Recipes.Values
            .SelectMany(recipe => recipe.Slots)
            .Select((slot, index) => CreateCard(
                $"METRIC_CARD_{index}",
                slot.RequiredTag ?? EnemyCardTag.Ability))
            .ToArray();

    /// <summary>
    /// 创建单配方、无软锁干扰的通用规划规则。
    /// </summary>
    private static EnemyCardPlanningRules CreateRules(EnemyActionRecipe recipe) =>
        new(
            new EnemySoftLockLimits(999m, 999m),
            new EnemySoftLockLimits(999m, 999m),
            maxCandidateAttempts: 1,
            stepLimit: 256,
            [new EnemyWeightedActionRecipe(recipe, 1)]);

    /// <summary>
    /// 创建并注册新的战斗级状态，并由注册表分配模板槽位身份。
    /// </summary>
    /// <param name="scope">用于隔离全局注册表的稳定名称片段。</param>
    /// <param name="cards">提供不可变定义的临时实例。</param>
    /// <returns>仅含初始抽牌堆的权威状态。</returns>
    private static EnemyCardCombatState CreateState(string scope, IReadOnlyList<BaseEnemyCard> cards)
    {
        EnemyCardDeckId deckId = new($"STS2_TOMORIN_MOD:PLANNER_{scope}_DECK");
        if (!EnemyCardDeckRegistry.IsRegistered(deckId))
        {
            EnemyCardDeckRegistry.Register(
                deckId,
                cards.Select(card => (Func<BaseEnemyCard>)(() => new HarnessEnemyCard(card.Definition))));
        }

        return EnemyCardDeckRegistry.CreateCombatState(deckId);
    }

    /// <summary>
    /// 创建带指定 Tag 和评分档案的领域测试实例。
    /// </summary>
    /// <param name="suffix">稳定 CardId 的后缀。</param>
    /// <param name="tags">定义 Tag。</param>
    /// <param name="scoreProfile">可选评分档案；默认零贡献。</param>
    /// <returns>尚未绑定模板身份的新实例。</returns>
    private static BaseEnemyCard CreateCard(
        string suffix,
        EnemyCardTag tags,
        EnemyCardScoreProfile? scoreProfile = null) =>
        new HarnessEnemyCard(new EnemyCardDefinition(
            new EnemyCardId($"STS2_TOMORIN_MOD:PLANNER_{suffix}"),
            new StrikeTomorin(),
            tags,
            scoreProfile ?? EnemyCardScoreProfile.Zero));

    /// <summary>
    /// 创建具有一项真实 Compose 素材请求的来源牌。
    /// </summary>
    private static BaseEnemyCard CreateComposeCard(string suffix, CardType materialType) =>
        new HarnessEnemyCard(new EnemyCardDefinition(
            new EnemyCardId($"STS2_TOMORIN_MOD:PLANNER_{suffix}"),
            new StrikeTomorin(),
            EnemyCardTag.Attack | EnemyCardTag.Compose,
            EnemyCardScoreProfile.Zero,
            materialRequests: [EnemyMaterialRequest.Compose(materialType, 1)]));

    /// <summary>创建可独立控制真实 CardType、Tag 与有序素材请求的测试牌。</summary>
    private static BaseEnemyCard CreateDefinedCard(
        string suffix,
        CardModel cardModel,
        EnemyCardTag tags,
        IEnumerable<EnemyMaterialRequest>? materialRequests = null,
        EnemyCardEffectClass effectClasses = EnemyCardEffectClass.None) =>
        new HarnessEnemyCard(new EnemyCardDefinition(
            new EnemyCardId($"STS2_TOMORIN_MOD:PLANNER_{suffix}"),
            cardModel,
            tags,
            EnemyCardScoreProfile.Zero,
            materialRequests: materialRequests,
            effectClasses: effectClasses));

    /// <summary>
    /// 把上次指标牌移回抽牌堆，同时保留 LastMetric 供不连续性验证。
    /// </summary>
    /// <param name="state">已完成一次规划的状态。</param>
    private static void ResetSelectedCardsToDraw(EnemyCardCombatState state)
    {
        foreach (EnemyCardInstanceKey key in state.CurrentCards.Select(card => card.InstanceKey).ToArray())
        {
            state.MoveCard(key, EnemyCardZone.Draw);
        }

        state.ClearPreparedAction();
    }

    /// <summary>
    /// 提供只承载不可变定义的领域测试敌人牌实例。
    /// </summary>
    private sealed class HarnessEnemyCard : BaseEnemyCard
    {
        /// <summary>
        /// 从共享语义定义创建新的未绑定身份实例。
        /// </summary>
        /// <param name="definition">不可变语义定义。</param>
        public HarnessEnemyCard(EnemyCardDefinition definition) : base(definition)
        {
        }
    }

    /// <summary>
    /// 使用预设索引序列记录所有随机请求，序列耗尽时返回首项。
    /// </summary>
    private sealed class RecordingRandomSource : IEnemyCardRandomSource
    {
        private readonly Queue<int> _indices;

        /// <summary>
        /// 创建确定性随机替身。
        /// </summary>
        /// <param name="indices">按调用顺序返回的原始索引。</param>
        public RecordingRandomSource(IEnumerable<int> indices)
        {
            _indices = new Queue<int>(indices);
        }

        /// <summary>获取随机索引请求总次数。</summary>
        public int CallCount { get; private set; }

        /// <summary>获取每次随机请求的排他上界。</summary>
        public List<int> UpperBounds { get; } = [];

        /// <inheritdoc />
        public int NextIndex(int exclusiveUpperBound)
        {
            CallCount++;
            UpperBounds.Add(exclusiveUpperBound);
            int value = _indices.Count > 0 ? _indices.Dequeue() : 0;
            return Math.Abs(value % exclusiveUpperBound);
        }
    }
}
