using System.Diagnostics;
using System.Reflection;
using MegaCrit.Sts2.Core.Combat;
using MegaCrit.Sts2.Core.GameActions.Multiplayer;
using MegaCrit.Sts2.Core.MonsterMoves.MonsterMoveStateMachine;
using STS2_Tomorin_Mod.Cards;
using STS2_Tomorin_Mod.Enemy.CardIntents;
using STS2_Tomorin_Mod.Enemy.CardIntents.Test;
using STS2_Tomorin_Mod.Powers;
using Xunit;

namespace CardIntentHarness;

/// <summary>
/// 验证深度优先执行引擎的重放、正常生命周期与素材不足边界。
/// </summary>
public sealed class ExecutionEngineTests
{
    [Theory]
    [InlineData(ShadowAbilityId.SorrowfulRain)]
    [InlineData(ShadowAbilityId.Adayume)]
    [InlineData(ShadowAbilityId.HeartBeat)]
    [InlineData(ShadowAbilityId.DuckAndCover)]
    [InlineData(ShadowAbilityId.NameOfTear)]
    [InlineData(ShadowAbilityId.UnwantedSixth)]
    public async Task RealAndSimulatedAbilityHooksProduceEquivalentDeltas(ShadowAbilityId ability)
    {
        string abilityId = ability.ToString().ToUpperInvariant();
        EnemyCardDefinition definition = new(
            new EnemyCardId($"STS2_TOMORIN_MOD:ABILITY_PARITY_{abilityId}"),
            new StrikeTomorin(),
            EnemyCardTag.Attack,
            EnemyCardScoreProfile.Zero);
        ExecutionFixture fixture = CreateFixture($"ABILITY_PARITY_{abilityId}", definition);
        Dictionary<Type, decimal> initial = ability switch
        {
            ShadowAbilityId.SorrowfulRain => new() { [typeof(CardIntentSorrowfulRainPower)] = 1m },
            ShadowAbilityId.Adayume => new() { [typeof(CardIntentAdayumePower)] = 1m },
            ShadowAbilityId.HeartBeat => new() { [typeof(CardIntentHeartBeatPower)] = 1m },
            ShadowAbilityId.DuckAndCover => new()
            {
                [typeof(DuckAndCoverPower)] = 1m,
                [typeof(AtFieldPower)] = 4m
            },
            ShadowAbilityId.NameOfTear => new() { [typeof(NameOfTearPower)] = 1m },
            _ => []
        };
        decimal realBlock = decimal.Zero;
        decimal realHeartWall = decimal.Zero;
        EnemyAbilityHookDispatcher dispatcher = new();
        EnemyCardExecutionContext execution = new(
            fixture.Owner,
            fixture.State,
            new ThrowingPlayerChoiceContext(),
            [],
            DispatchProxy.Create<ICombatState, NullCombatStateProxy>(),
            defendExecutor: amount =>
            {
                realBlock += amount;
                return Task.CompletedTask;
            },
            enemyPowerExecutor: (type, amount) =>
            {
                if (type == typeof(AtFieldPower))
                {
                    realHeartWall += amount;
                }

                return Task.CompletedTask;
            },
            initialEnemyPowers: initial);
        execution.UseAbilityHooks(dispatcher);
        Dictionary<string, decimal> initialProjectionPowers = initial.ToDictionary(
            item => item.Key.FullName ?? item.Key.Name,
            item => item.Value,
            StringComparer.Ordinal);
        EnemyCardSimulationContext simulation = new(
            [],
            stepLimit: 32,
            initialState: new EnemyProjectionInitialState(enemyPowers: initialProjectionPowers),
            abilityHooks: dispatcher);

        switch (ability)
        {
            case ShadowAbilityId.SorrowfulRain:
                await dispatcher.AfterComposeAsync(execution);
                dispatcher.SimulateAfterCompose(simulation);
                break;
            case ShadowAbilityId.Adayume:
                await dispatcher.AfterSuccessfulUnitAsync(execution);
                dispatcher.SimulateAfterSuccessfulUnit(simulation);
                break;
            case ShadowAbilityId.HeartBeat:
                BaseEnemyCard card = Assert.Single(fixture.State.CombatState.DrawPile);
                await dispatcher.AfterNormalLifecycleExhaustAsync(execution, card);
                dispatcher.SimulateAfterNormalLifecycleExhaust(simulation, card.InstanceKey);
                break;
            case ShadowAbilityId.DuckAndCover:
                await dispatcher.BeforePreparationAsync(execution);
                dispatcher.SimulateBeforePreparation(simulation);
                break;
            case ShadowAbilityId.UnwantedSixth:
                execution.AddTransientAbility<CardIntentUnwantedSixthPower>(1m);
                simulation.AddTransientAbility<CardIntentUnwantedSixthPower>(1m);
                await execution.ExecuteDefendAsync(2m);
                simulation.AddEnemyBlock(2m);
                break;
            case ShadowAbilityId.NameOfTear:
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(ability));
        }

        EnemyProjectionEndState simulated = simulation.BuildProjection().EndState;
        decimal initialHeartWall = initial.GetValueOrDefault(typeof(AtFieldPower));
        Assert.Equal(realBlock, simulated.EnemyBlock);
        Assert.Equal(
            realHeartWall,
            simulated.GetEnemyPower(typeof(AtFieldPower).FullName!) - initialHeartWall);
    }

    /// <summary>
    /// 验证前置显式程序先执行即时子牌，且真实权威栈在子牌期间阻止阶段迁移。
    /// </summary>
    [Fact]
    public async Task ImmediateComposeUsesExplicitOrderAndAuthoritativeImmediateStack()
    {
        EnemyCardDefinition tokenDefinition = CardIntentTestCardCatalog.AllDefinitions.Values.Single(definition =>
            definition.CardId.Value.EndsWith("_HITOSHIZUKU_TOKEN", StringComparison.Ordinal));
        List<string> sequence = [];
        EnemyCardDefinition sourceDefinition = new(
            new EnemyCardId("STS2_TOMORIN_MOD:EXECUTION_ORDERED_COMPOSE_SOURCE"),
            new Hitoshizuku(),
            EnemyCardTag.Attack | EnemyCardTag.Compose,
            EnemyCardScoreProfile.Zero,
            lifecycle: EnemyCardLifecycle.Exhaust,
            tokenTiming: EnemyCardTokenTiming.Immediate,
            composeResultCardId: tokenDefinition.CardId,
            effects:
            [
                new EnemyCardEffectNode(
                    "TEST:ORDERED_COMPOSE:SOURCE",
                    _ => { },
                    context =>
                    {
                        Assert.Empty(context.State.CombatState.ImmediateResolutionStack);
                        sequence.Add("source");
                        return Task.CompletedTask;
                    })
            ],
            customExecutionTiming: EnemyCardCustomExecutionTiming.BeforeBaseEffects);
        ExecutionFixture fixture = CreateFixture("ORDERED_COMPOSE", sourceDefinition);
        EnemyCardCombatState combatState = fixture.State.CombatState;
        BaseEnemyCard source = Assert.Single(combatState.DrawPile);
        combatState.MoveCard(source.InstanceKey, EnemyCardZone.Current);
        EnemyCardInstanceKey resultKey = EnemyCardInstanceKey.FromRuntimeInstanceId(
            combatState.NextGeneratedCardSequence);
        PreparedEnemyCardUnitPlan child = new(
            source.InstanceKey,
            resultKey,
            tokenDefinition.CardId,
            replayIndex: 0,
            EnemyPreparedExecutionMode.Normal,
            materialReservations: [],
            orderedSteps: [new PreparedDirectEffectsStep(tokenDefinition.EffectProgramIds)],
            tokenDefinition.ResolutionProgram.Fingerprint,
            tokenDefinition.PlayCondition.ProgramId);
        PreparedComposeResultStep compose = new(
            tokenDefinition.CardId,
            resultKey,
            EnemyCardTokenTiming.Immediate,
            increasesExistingReplay: false,
            child);
        PreparedEnemyCardUnitPlan sourceUnit = new(
            source.InstanceKey,
            source.InstanceKey,
            source.CardId,
            replayIndex: 0,
            EnemyPreparedExecutionMode.Normal,
            materialReservations: [],
            orderedSteps:
            [
                compose,
                new PreparedDirectEffectsStep(sourceDefinition.EffectProgramIds)
            ],
            sourceDefinition.ResolutionProgram.Fingerprint,
            sourceDefinition.PlayCondition.ProgramId);
        SetPreparedAction(fixture.State, source, sourceUnit);

        CardIntentTestRules rules = CardIntentTestRules.ForTesting(
            new EnemyActionRecipe(EnemyActionMetric.Attack, [null]));
        EnemyCardExecutionContext context = new(
            fixture.Owner,
            fixture.State,
            new ThrowingPlayerChoiceContext(),
            [],
            DispatchProxy.Create<ICombatState, NullCombatStateProxy>(),
            shouldStopExecution: () => false,
            attackAllExecutor: (_, _) =>
            {
                BaseEnemyCard immediate = Assert.Single(combatState.ImmediateResolutionStack);
                Assert.Equal(tokenDefinition.CardId, immediate.CardId);
                Assert.Equal(EnemyCardRuntimePhase.Executing, combatState.RuntimePhase);
                EnemyCardPhaseTemplate dummyNextPhase = new(
                    EnemyCardPhase.Phase2,
                    [() => new ExecutionEnemyCard(sourceDefinition)],
                    rules,
                    initialSourceInstanceCount: 1);
                InvalidOperationException guard = Assert.Throws<InvalidOperationException>(() =>
                    combatState.BuildPhaseTransitionCandidate(
                        dummyNextPhase,
                        new EnemyCardRandomSource(_ => 0)));
                Assert.Contains("无即时结算栈", guard.Message, StringComparison.Ordinal);
                sequence.Add("child");
                return Task.CompletedTask;
            },
            collectionPowerExecutor: _ => Task.CompletedTask);
        EnemyCardExecutionEngine engine = new(
            abilityHooks: new NoOpAbilityHooks(),
            delayExecutor: (_, _) => Task.CompletedTask);

        await engine.ExecutePreparedActionAsync(
            combatState,
            context,
            new EnemyCardRandomSource(_ => 0),
            stepLimit: 32);

        Assert.Equal(["child", "source"], sequence);
        Assert.Empty(combatState.ImmediateResolutionStack);
        Assert.NotEqual(EnemyCardRuntimePhase.Faulted, combatState.RuntimePhase);
    }

    /// <summary>验证实时条件失效只置灰并跳过该牌，不污染投影完整性或整轮执行。</summary>
    [Fact]
    public async Task FrozenConditionFailureMarksOnlyCardUnavailableAndExecutionContinues()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = new(
            new EnemyCardId("STS2_TOMORIN_MOD:EXECUTION_FROZEN_CONDITION"),
            new StrikeTomorin(),
            EnemyCardTag.Attack,
            new EnemyCardScoreProfile(attack: attack),
            effects: [new EnemyAttackAllEffect("TEST:FROZEN_CONDITION:ATTACK", attack)],
            playCondition: new PlanOnlyCondition());
        List<decimal> attacks = [];
        ExecutionFixture fixture = CreateFixture(
            "FROZEN_CONDITION",
            definition,
            attackAllExecutor: (amount, _) =>
            {
                attacks.Add(amount);
                return Task.CompletedTask;
            });
        EnemyCardCombatState combatState = PrepareSingleUnitAction(fixture.State, definition);
        PreparedEnemyCardAction action = combatState.PreparedAction!;

        LiveActionProjection projection = new EnemyActionProjectionService().Project(
            action,
            new EnemyActionProjectionInput([new EnemySimulationTarget("TARGET", 1m, 1m)], 64));
        await fixture.State.ExecuteCardsAsync([]);

        Assert.True(projection.IsComplete);
        Assert.Contains(action.Sources.Single().SourceKey, projection.UnavailableCardKeys);
        Assert.Empty(attacks);
        Assert.Equal(EnemyCardRuntimePhase.Idle, combatState.RuntimePhase);
        Assert.Null(combatState.FaultDiagnostic);
    }

    /// <summary>验证真实条件检查发生在当前执行实例入栈之后，ThisNoNeed 能排除自身并消费另一来源。</summary>
    [Fact]
    public async Task ThisNoNeedConditionCanReadCurrentExecutingCardBeforeEffects()
    {
        EnemyCardDefinition sourceDefinition = ShadowTomorinCardCatalog.Get("THIS_NO_NEED");
        EnemyCardDefinition expendableDefinition = CreateDefinition(
            "THIS_NO_NEED_EXPENDABLE",
            attack: 1m,
            block: decimal.Zero,
            EnemyCardLifecycle.Discard);
        ExecutionFixture fixture = CreateFixture(
            "THIS_NO_NEED_CONDITION",
            sourceDefinition,
            attackAllExecutor: (_, _) => Task.CompletedTask,
            defendExecutor: _ => Task.CompletedTask);
        EnemyCardCombatState combatState = PrepareSingleUnitAction(fixture.State, sourceDefinition);
        ExecutionEnemyCard expendable = new(expendableDefinition);
        combatState.AddGeneratedCard(expendable, EnemyCardZone.Current);

        await fixture.State.ExecuteCardsAsync([]);

        Assert.False(
            combatState.RuntimePhase == EnemyCardRuntimePhase.Faulted,
            combatState.FaultDiagnostic);
        Assert.Equal(EnemyCardRuntimePhase.Idle, combatState.RuntimePhase);
        Assert.Null(combatState.FaultDiagnostic);
        Assert.Contains(combatState.ExhaustPile, card => card.InstanceKey == expendable.InstanceKey);
        Assert.DoesNotContain(combatState.CurrentCards, card => card.InstanceKey == expendable.InstanceKey);
    }

    /// <summary>
    /// 验证生产执行引擎在有效卡牌效果完成后保留两秒展示时间。
    /// </summary>
    [Fact]
    public async Task EffectfulCardUnitPausesForTwoSecondsAfterResolving()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = CreateDefinition(
            "PACING",
            attack,
            decimal.Zero,
            EnemyCardLifecycle.Discard);
        Stopwatch stopwatch = new();
        TimeSpan? effectCompletedAt = null;
        ExecutionFixture fixture = CreateFixture("PACING", definition);
        EnemyCardCombatState combatState = PrepareSingleUnitAction(fixture.State, definition);
        EnemyCardExecutionContext context = new(
            fixture.Owner,
            fixture.State,
            new ThrowingPlayerChoiceContext(),
            [],
            DispatchProxy.Create<ICombatState, NullCombatStateProxy>(),
            shouldStopExecution: () => false,
            attackAllExecutor: (_, _) =>
            {
                effectCompletedAt = stopwatch.Elapsed;
                return Task.CompletedTask;
            },
            collectionPowerExecutor: _ => Task.CompletedTask);
        EnemyCardExecutionEngine engine = new(abilityHooks: new NoOpAbilityHooks());

        stopwatch.Start();
        await engine.ExecutePreparedActionAsync(
            combatState,
            context,
            new EnemyCardRandomSource(_ => 0),
            stepLimit: 16);
        stopwatch.Stop();

        Assert.NotNull(effectCompletedAt);
        Assert.InRange(effectCompletedAt.Value, TimeSpan.Zero, TimeSpan.FromMilliseconds(500));
        Assert.InRange(stopwatch.Elapsed, TimeSpan.FromMilliseconds(1800), TimeSpan.FromSeconds(5));
    }

    /// <summary>验证没有提交任何卡牌效果的成功单元不会产生展示停顿。</summary>
    [Fact]
    public async Task EmptyCardUnitDoesNotPause()
    {
        EnemyCardDefinition definition = new(
            new EnemyCardId("STS2_TOMORIN_MOD:EXECUTION_EMPTY_PACING_CARD"),
            new StrikeTomorin(),
            EnemyCardTag.Ability,
            EnemyCardScoreProfile.Zero,
            effects: []);
        ExecutionFixture fixture = CreateFixture("EMPTY_PACING", definition);
        EnemyCardCombatState combatState = PrepareSingleUnitAction(fixture.State, definition);
        EnemyCardExecutionContext context = new(
            fixture.Owner,
            fixture.State,
            new ThrowingPlayerChoiceContext(),
            [],
            DispatchProxy.Create<ICombatState, NullCombatStateProxy>(),
            shouldStopExecution: () => false,
            collectionPowerExecutor: _ => Task.CompletedTask);
        List<TimeSpan> pauses = [];
        EnemyCardExecutionEngine engine = new(
            abilityHooks: new NoOpAbilityHooks(),
            delayExecutor: (duration, _) =>
            {
                pauses.Add(duration);
                return Task.CompletedTask;
            });

        await engine.ExecutePreparedActionAsync(
            combatState,
            context,
            new EnemyCardRandomSource(_ => 0),
            stepLimit: 16);

        Assert.Empty(pauses);
    }

    /// <summary>验证同一牌的每次成功重放都在效果后独立停顿。</summary>
    [Fact]
    public async Task ReplayUnitsEachPauseAfterTheirEffects()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = CreateDefinition(
            "REPLAY_PACING",
            attack,
            decimal.Zero,
            EnemyCardLifecycle.Discard);
        ExecutionFixture fixture = CreateFixture("REPLAY_PACING", definition);
        EnemyCardCombatState combatState = PrepareAction(fixture.State, definition, successfulUnitCount: 2);
        List<string> sequence = [];
        EnemyCardExecutionContext context = new(
            fixture.Owner,
            fixture.State,
            new ThrowingPlayerChoiceContext(),
            [],
            DispatchProxy.Create<ICombatState, NullCombatStateProxy>(),
            shouldStopExecution: () => false,
            attackAllExecutor: (_, _) =>
            {
                sequence.Add("effect");
                return Task.CompletedTask;
            },
            collectionPowerExecutor: _ => Task.CompletedTask);
        EnemyCardExecutionEngine engine = new(
            abilityHooks: new NoOpAbilityHooks(),
            delayExecutor: (duration, _) =>
            {
                Assert.Equal(TimeSpan.FromSeconds(2), duration);
                sequence.Add("pause");
                return Task.CompletedTask;
            });

        await engine.ExecutePreparedActionAsync(
            combatState,
            context,
            new EnemyCardRandomSource(_ => 0),
            stepLimit: 16);

        Assert.Equal(["effect", "pause", "effect", "pause"], sequence);
    }

    /// <summary>
    /// 验证每次冻结重放各执行一次直接效果，并且成功来源按定义进入弃牌堆。
    /// </summary>
    [Fact]
    public async Task ReplayExecutesEachFrozenAttemptThenAppliesSuccessLifecycle()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        decimal block = new DefendTomorin().DynamicVars.Block.BaseValue;
        EnemyCardDefinition definition = CreateDefinition(
            "REPLAY",
            attack,
            block,
            EnemyCardLifecycle.Discard);
        ExecutionFixture fixture = CreateFixture("REPLAY", definition);
        BaseEnemyCard card = fixture.State.CombatState.DrawPile.Single();
        card.IncreaseReplayCount();
        List<decimal> attacks = [];
        List<decimal> blocks = [];
        fixture = CreateFixture(
            "REPLAY_EXECUTE",
            definition,
            attackAllExecutor: (amount, _) =>
            {
                attacks.Add(amount);
                return Task.CompletedTask;
            },
            defendExecutor: amount =>
            {
                blocks.Add(amount);
                return Task.CompletedTask;
            });
        card = fixture.State.CombatState.DrawPile.Single();
        card.IncreaseReplayCount();
        PrepareWithoutGodotLogging(fixture);
        int frozenAttempts = fixture.State.CombatState.PreparedAction!.Sources.Single().MaximumAttempts;

        await fixture.State.ExecuteCardsAsync([]);

        Assert.Equal(frozenAttempts, attacks.Count);
        Assert.Equal(frozenAttempts, blocks.Count);
        Assert.All(attacks, amount => Assert.Equal(attack, amount));
        Assert.All(blocks, amount => Assert.Equal(block, amount));
        Assert.Contains(fixture.State.CombatState.DiscardPile, item => item.InstanceKey == card.InstanceKey);
        Assert.Equal(EnemyCardRuntimePhase.Idle, fixture.State.CombatState.RuntimePhase);
    }

    /// <summary>
    /// 验证正常素材不足不会执行本体、不会进入故障态，并按失败去向保留来源牌。
    /// </summary>
    [Fact]
    public async Task MaterialShortfallIsNormalAndUsesFailureDisposition()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = new(
            new EnemyCardId("STS2_TOMORIN_MOD:EXECUTION_SHORTFALL_CARD"),
            new StrikeTomorin(),
            EnemyCardTag.Attack | EnemyCardTag.Compose,
            new EnemyCardScoreProfile(attack: attack),
            materialRequests: [EnemyMaterialRequest.Compose(MegaCrit.Sts2.Core.Entities.Cards.CardType.Attack, 1)],
            failureDisposition: EnemyCardFailureDisposition.Retain,
            effects: [new EnemyAttackAllEffect("EXECUTION:SHORTFALL:ATTACK", attack)]);
        List<decimal> attacks = [];
        ExecutionFixture fixture = CreateFixture(
            "SHORTFALL",
            definition,
            attackAllExecutor: (amount, _) =>
            {
                attacks.Add(amount);
                return Task.CompletedTask;
            });
        BaseEnemyCard card = fixture.State.CombatState.DrawPile.Single();
        PrepareWithoutGodotLogging(fixture);

        await fixture.State.ExecuteCardsAsync([]);

        Assert.Empty(attacks);
        Assert.False(fixture.State.IsFaulted);
        Assert.Contains(fixture.State.CombatState.RetainedCards, item => item.InstanceKey == card.InstanceKey);
    }

    /// <summary>
    /// 验证成功来源的消耗生命周期与能力钩子替身不会改变直接效果次数。
    /// </summary>
    [Fact]
    public async Task ExhaustLifecycleMovesTheSameInstanceAfterSuccess()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = CreateDefinition(
            "EXHAUST",
            attack,
            decimal.Zero,
            EnemyCardLifecycle.Exhaust);
        List<decimal> attacks = [];
        ExecutionFixture fixture = CreateFixture(
            "EXHAUST",
            definition,
            attackAllExecutor: (amount, _) =>
            {
                attacks.Add(amount);
                return Task.CompletedTask;
            });
        BaseEnemyCard card = fixture.State.CombatState.DrawPile.Single();
        PrepareWithoutGodotLogging(fixture);
        int frozenAttempts = fixture.State.CombatState.PreparedAction!.Sources.Single().MaximumAttempts;

        await fixture.State.ExecuteCardsAsync([]);

        Assert.Equal(frozenAttempts, attacks.Count);
        Assert.False(fixture.State.IsFaulted, fixture.State.CombatState.FaultDiagnostic);
        Assert.Contains(fixture.State.CombatState.ExhaustPile, item => item.InstanceKey == card.InstanceKey);
        Assert.DoesNotContain(fixture.State.CombatState.DiscardPile, item => item.InstanceKey == card.InstanceKey);
    }

    /// <summary>
    /// 验证随机收藏品在准备阶段冻结，实际执行只读取稳定结果且不再次推进战斗 RNG。
    /// </summary>
    [Fact]
    public async Task RandomCollectionResultsAreFrozenBeforeExecution()
    {
        WhyPlayHaruhikage model = new();
        decimal attack = model.DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = new(
            new EnemyCardId("STS2_TOMORIN_MOD:EXECUTION_FROZEN_RANDOM_CARD"),
            model,
            EnemyCardTag.Attack | EnemyCardTag.CollectionGenerator,
            new EnemyCardScoreProfile(attack: attack),
            effects: [new EnemyAttackAllEffect("EXECUTION:FROZEN_RANDOM:ATTACK", attack)]);
        int randomCalls = 0;
        ExecutionFixture fixture = CreateFixture(
            "FROZEN_RANDOM",
            definition,
            attackAllExecutor: (_, _) => Task.CompletedTask,
            randomIndexSelector: _ =>
            {
                randomCalls++;
                return 0;
            });
        PrepareWithoutGodotLogging(fixture);
        PreparedEnemyCardSource source = fixture.State.CombatState.PreparedAction!.Sources.Single();
        int callsAfterPreparation = randomCalls;
        int frozenCollectionResults = source.Units
            .SelectMany(unit => unit.OrderedSteps)
            .OfType<PreparedGeneratedCollectionStep>()
            .Count();

        await fixture.State.ExecuteCardsAsync([]);

        Assert.Equal(callsAfterPreparation, randomCalls);
        Assert.Equal(frozenCollectionResults, fixture.State.CombatState.CollectionQueue.Count);
        Assert.Equal(
            frozenCollectionResults,
            fixture.State.CombatState.CollectionQueue.Select(item => item.CollectionInstanceId).Distinct().Count());
    }

    [Fact]
    public async Task ShadowCollectionGeneratorFreezesWeightedDistinctResultsBeforeExecution()
    {
        EnemyCollectionDefinition[] pool = CardIntentTestCollectionCatalog.Catalog.Definitions.Take(2).ToArray();
        EnemyCardDefinition definition = new(
            new EnemyCardId("STS2_TOMORIN_MOD:EXECUTION_SHADOW_FROZEN_COLLECTIONS"),
            new WhyPlayHaruhikage(),
            EnemyCardTag.CollectionGenerator,
            EnemyCardScoreProfile.Zero,
            effects:
            [
                ShadowTomorinEffects.GenerateFrozenCollections(
                    "SHADOW:FROZEN_COLLECTIONS",
                    [(pool[0], 1), (pool[1], 1)],
                    count: 2)
            ]);
        int randomCalls = 0;
        ExecutionFixture fixture = CreateFixture(
            "SHADOW_FROZEN_COLLECTIONS",
            definition,
            randomIndexSelector: _ =>
            {
                randomCalls++;
                return 0;
            });
        PrepareWithoutGodotLogging(fixture);
        int callsAfterPreparation = randomCalls;
        PreparedGeneratedCollectionStep[] frozen = fixture.State.CombatState.PreparedAction!.Sources
            .SelectMany(source => source.Units)
            .SelectMany(unit => unit.OrderedSteps)
            .OfType<PreparedGeneratedCollectionStep>()
            .ToArray();

        await fixture.State.ExecuteCardsAsync([]);

        Assert.Equal(2, frozen.Length);
        Assert.Equal(2, frozen.Select(item => item.CollectionId).Distinct(StringComparer.Ordinal).Count());
        Assert.Equal(callsAfterPreparation, randomCalls);
        Assert.Equal(frozen.Select(item => item.CollectionId),
            fixture.State.CombatState.CollectionQueue.Select(item => item.Definition.CollectionId));
    }

    [Fact]
    public void ShadowFormPreparationReservesOneWeightedCollectionWithoutMutatingAvailable()
    {
        EnemyCardDefinition definition = CreateDefinition(
            "SHADOW_FORM_PREPARATION",
            decimal.Zero,
            decimal.Zero,
            EnemyCardLifecycle.Discard);
        ExecutionFixture fixture = CreateFixture("SHADOW_FORM_PREPARATION", definition);
        EnemyCollectionDefinition[] pool = CardIntentTestCollectionCatalog.Catalog.Definitions.Take(2).ToArray();
        int randomCalls = 0;

        EnemyPreparationCycle cycle = new ShadowTomoriFormPower().CreatePreparationCycle(
            fixture.State.CombatState,
            new EnemyCardRandomSource(bound =>
            {
                randomCalls++;
                Assert.Equal(3, bound);
                return 2;
            }),
            [(pool[0], 1), (pool[1], 2)]);

        Assert.Equal(1, randomCalls);
        Assert.Empty(fixture.State.CombatState.CollectionQueue);
        Assert.NotNull(cycle.FrozenPreparationCollection);
        Assert.Equal(pool[1].CollectionId, cycle.FrozenPreparationCollection!.Definition.CollectionId);
        Assert.Equal(fixture.State.CombatState.CollectionInventory.NextSequence,
            cycle.FrozenPreparationCollection.Sequence);
        Assert.Same(cycle.FrozenPreparationCollection, Assert.Single(cycle.Delta.AddedAvailable));
    }

    /// <summary>验证执行阶段结构故障会输出上下文、完整异常及内部异常，而不是静默进入 Faulted。</summary>
    [Fact]
    public async Task ExecutionFaultLogsFullExceptionAndFailureContext()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = CreateDefinition(
            "FAULT_LOG",
            attack,
            decimal.Zero,
            EnemyCardLifecycle.Discard);
        ExecutionFixture fixture = CreateFixture(
            "FAULT_LOG",
            definition,
            attackAllExecutor: ThrowExecutionFailure);
        PrepareWithoutGodotLogging(fixture);

        await fixture.State.ExecuteCardsAsync([]);

        Assert.True(fixture.State.IsFaulted);
        string log = Assert.Single(fixture.Owner.ErrorMessages);
        Assert.Contains("[CardIntentFault]", log, StringComparison.Ordinal);
        Assert.Contains("Stage=Execution", log, StringComparison.Ordinal);
        Assert.Contains("StateId=EXECUTION_FAULT_LOG", log, StringComparison.Ordinal);
        Assert.Contains("PhaseBeforeFault=Executing", log, StringComparison.Ordinal);
        Assert.Contains("InvalidOperationException", log, StringComparison.Ordinal);
        Assert.Contains("execution outer failure", log, StringComparison.Ordinal);
        Assert.Contains("ApplicationException", log, StringComparison.Ordinal);
        Assert.Contains("execution inner failure", log, StringComparison.Ordinal);
        Assert.Contains(nameof(ThrowExecutionFailure), log, StringComparison.Ordinal);
    }

    /// <summary>验证准备阶段异常也输出同一组故障上下文和完整异常链。</summary>
    [Fact]
    public void PreparationFaultLogsFullExceptionAndFailureContext()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = CreateDefinition(
            "PREPARATION_FAULT_LOG",
            attack,
            decimal.Zero,
            EnemyCardLifecycle.Discard);
        ExecutionFixture fixture = CreateFixture(
            "PREPARATION_FAULT_LOG",
            definition,
            randomIndexSelector: ThrowPreparationFailure);

        Assert.False(fixture.State.PrepareCards());

        Assert.True(fixture.State.IsFaulted);
        string log = Assert.Single(fixture.Owner.ErrorMessages);
        Assert.Contains("[CardIntentFault]", log, StringComparison.Ordinal);
        Assert.Contains("Stage=Preparation", log, StringComparison.Ordinal);
        Assert.Contains("StateId=EXECUTION_PREPARATION_FAULT_LOG", log, StringComparison.Ordinal);
        Assert.Contains("PhaseBeforeFault=Idle", log, StringComparison.Ordinal);
        Assert.Contains("InvalidOperationException", log, StringComparison.Ordinal);
        Assert.Contains("preparation outer failure", log, StringComparison.Ordinal);
        Assert.Contains("ApplicationException", log, StringComparison.Ordinal);
        Assert.Contains("preparation inner failure", log, StringComparison.Ordinal);
        Assert.Contains(nameof(ThrowPreparationFailure), log, StringComparison.Ordinal);
    }

    /// <summary>验证应用远端 Faulted 状态时输出其持久化失败原因，并注明不存在本机异常堆栈。</summary>
    [Fact]
    public void ReconnectRestoredFaultLogsPersistedReasonWithoutInventingException()
    {
        decimal attack = new StrikeTomorin().DynamicVars.Damage.BaseValue;
        EnemyCardDefinition definition = CreateDefinition(
            "RECONNECT_FAULT_LOG",
            attack,
            decimal.Zero,
            EnemyCardLifecycle.Discard);
        ExecutionFixture fixture = CreateFixture("RECONNECT_FAULT_LOG", definition);
        EnemyCardCombatState restored = EnemyCardDeckRegistry.CreateCombatState(fixture.State.DeckId);
        restored.MarkFault("remote persisted failure reason");

        typeof(CardIntentMoveState)
            .GetMethod("ApplyValidatedCombatState", BindingFlags.Instance | BindingFlags.NonPublic)!
            .Invoke(fixture.State, [restored]);

        string log = Assert.Single(fixture.Owner.ErrorMessages);
        Assert.Contains("[CardIntentFault]", log, StringComparison.Ordinal);
        Assert.Contains("Stage=ReconnectRestore", log, StringComparison.Ordinal);
        Assert.Contains("StateId=EXECUTION_RECONNECT_FAULT_LOG", log, StringComparison.Ordinal);
        Assert.Contains("PhaseBeforeFault=Unavailable(RemoteFault)", log, StringComparison.Ordinal);
        Assert.Contains("remote persisted failure reason", log, StringComparison.Ordinal);
        Assert.Contains("Exception=Unavailable", log, StringComparison.Ordinal);
    }

    /// <summary>构造具有内部异常和可辨识堆栈帧的执行失败。</summary>
    private static Task ThrowExecutionFailure(decimal _, int __) =>
        throw new InvalidOperationException(
            "execution outer failure",
            new ApplicationException("execution inner failure"));

    /// <summary>构造具有内部异常和可辨识堆栈帧的准备失败。</summary>
    private static int ThrowPreparationFailure(int _) =>
        throw new InvalidOperationException(
            "preparation outer failure",
            new ApplicationException("preparation inner failure"));

    /// <summary>创建带标准全体攻击和自身格挡节点的测试定义。</summary>
    private static EnemyCardDefinition CreateDefinition(
        string scope,
        decimal attack,
        decimal block,
        EnemyCardLifecycle lifecycle) =>
        new(
            new EnemyCardId($"STS2_TOMORIN_MOD:EXECUTION_{scope}_CARD"),
            new StrikeTomorin(),
            EnemyCardTag.Attack | (block > decimal.Zero ? EnemyCardTag.Defense : EnemyCardTag.None),
            new EnemyCardScoreProfile(attack: attack, block: block),
            lifecycle: lifecycle,
            effects: CreateEffects(scope, attack, block));

    /// <summary>只为正数基础值创建对应标准效果节点。</summary>
    private static IReadOnlyList<IEnemyCardEffectNode> CreateEffects(
        string scope,
        decimal attack,
        decimal block)
    {
        List<IEnemyCardEffectNode> effects =
            [new EnemyAttackAllEffect($"EXECUTION:{scope}:ATTACK", attack)];
        if (block > decimal.Zero)
        {
            effects.Add(new EnemyBlockEffect($"EXECUTION:{scope}:BLOCK", block));
        }

        return effects.AsReadOnly();
    }

    /// <summary>提交一个调用方已完整冻结的自定义单元，供真实执行路径测试。</summary>
    private static void SetPreparedAction(
        CardIntentMoveState moveState,
        BaseEnemyCard card,
        PreparedEnemyCardUnitPlan unit)
    {
        PreparedEnemyCardAction action = new(
            EnemyActionMetric.Attack,
            retainedPrefix: [],
            metricCards: [card],
            sources: [new PreparedEnemyCardSource(card, maximumAttempts: 1, [unit])],
            new EnemySoftLockDiagnostic(
                new EnemyCardScore(decimal.Zero, decimal.Zero),
                attackLock: decimal.Zero,
                totalScoreLock: decimal.Zero,
                candidateAttemptCount: 1,
                rejectedCandidateCount: 0,
                wasForcedByAttemptLimit: false));
        typeof(EnemyCardCombatState)
            .GetProperty(nameof(EnemyCardCombatState.PreparedAction))!
            .SetValue(moveState.CombatState, action);
        typeof(EnemyCardCombatState)
            .GetProperty(nameof(EnemyCardCombatState.RuntimePhase))!
            .SetValue(moveState.CombatState, EnemyCardRuntimePhase.Prepared);
    }

    /// <summary>绕过 Godot 日志入口，为纯执行测试提交一个成功冻结单元。</summary>
    private static EnemyCardCombatState PrepareSingleUnitAction(
        CardIntentMoveState moveState,
        EnemyCardDefinition definition) =>
        PrepareAction(moveState, definition, successfulUnitCount: 1);

    /// <summary>绕过 Godot 日志入口，为纯执行测试提交指定数量的成功冻结单元。</summary>
    private static EnemyCardCombatState PrepareAction(
        CardIntentMoveState moveState,
        EnemyCardDefinition definition,
        int successfulUnitCount)
    {
        EnemyCardCombatState state = moveState.CombatState;
        BaseEnemyCard card = state.DrawPile.Single();
        state.MoveCard(card.InstanceKey, EnemyCardZone.Current);
        PreparedEnemyCardUnitPlan[] units = Enumerable.Range(0, successfulUnitCount)
            .Select(replayIndex => new PreparedEnemyCardUnitPlan(
                card.InstanceKey,
                card.InstanceKey,
                card.CardId,
                replayIndex,
                EnemyPreparedExecutionMode.Normal,
                materialReservations: [],
                orderedSteps:
                [
                    new PreparedDirectEffectsStep(definition.Effects.Select(effect => effect.ProgramId))
                ]))
            .ToArray();
        PreparedEnemyCardAction action = new(
            EnemyActionMetric.Attack,
            retainedPrefix: [],
            metricCards: [card],
            sources: [new PreparedEnemyCardSource(card, successfulUnitCount, units)],
            new EnemySoftLockDiagnostic(
                new EnemyCardScore(decimal.Zero, decimal.Zero),
                attackLock: decimal.Zero,
                totalScoreLock: decimal.Zero,
                candidateAttemptCount: 1,
                rejectedCandidateCount: 0,
                wasForcedByAttemptLimit: false),
            effectiveCardStates:
            [
                new EnemyFrozenEffectiveCardState(
                    card.InstanceKey,
                    frozenN: 0,
                    frozenX: null,
                    multiplier: 1,
                    wasCounted: true)
            ]);
        typeof(EnemyCardCombatState)
            .GetProperty(nameof(EnemyCardCombatState.PreparedAction))!
            .SetValue(state, action);
        typeof(EnemyCardCombatState)
            .GetProperty(nameof(EnemyCardCombatState.RuntimePhase))!
            .SetValue(state, EnemyCardRuntimePhase.Prepared);
        return state;
    }

    /// <summary>直接调用领域 planner，避开纯 .NET 测试宿主无法初始化的 Godot 日志外壳。</summary>
    private static PreparedEnemyCardAction PrepareWithoutGodotLogging(ExecutionFixture fixture) =>
        new EnemyActionMetricPlanner(fixture.Rules, new EnemyCardScoreCalculator()).Prepare(
            fixture.State.CombatState,
            new EnemyPlanningContext(new EnemyCardRandomSource(fixture.RandomIndexSelector)));

    /// <summary>创建仅含一个来源实例、单槽配方和全部无副作用测试 seam 的执行夹具。</summary>
    private static ExecutionFixture CreateFixture(
        string scope,
        EnemyCardDefinition definition,
        Func<decimal, int, Task>? attackAllExecutor = null,
        Func<decimal, Task>? defendExecutor = null,
        Func<int, int>? randomIndexSelector = null)
    {
        EnemyCardDeckId deckId = new($"STS2_TOMORIN_MOD:EXECUTION_{scope}_DECK");
        if (!EnemyCardDeckRegistry.IsRegistered(deckId))
        {
            EnemyCardDeckRegistry.Register(deckId, [() => new ExecutionEnemyCard(definition)]);
        }

        EnemyActionRecipe recipe = new(EnemyActionMetric.Attack, [null]);
        CardIntentTestRules rules = CardIntentTestRules.ForTesting(recipe);
        HarnessMonster owner = new();
        Func<int, int> resolvedRandomIndexSelector = randomIndexSelector ?? (_ => 0);
        CardIntentMoveState state = CardIntentMoveState.Create(
            $"EXECUTION_{scope}",
            owner,
            deckId,
            recipe.Slots.Count,
            randomIndexSelector: resolvedRandomIndexSelector,
            shouldStopExecution: () => false,
            defendExecutor: defendExecutor,
            attackAllExecutor: attackAllExecutor,
            collectionPowerExecutor: _ => Task.CompletedTask,
            combatStateOverride: DispatchProxy.Create<ICombatState, NullCombatStateProxy>(),
            rules: rules,
            executionEngine: new EnemyCardExecutionEngine(
                abilityHooks: new NoOpAbilityHooks(),
                delayExecutor: (_, _) => Task.CompletedTask));
        return new ExecutionFixture(state, owner, rules, resolvedRandomIndexSelector);
    }

    /// <summary>保存执行测试所需的行动状态。</summary>
    private sealed record ExecutionFixture(
        CardIntentMoveState State,
        HarnessMonster Owner,
        EnemyCardPlanningRules Rules,
        Func<int, int> RandomIndexSelector);

    /// <summary>承载共享定义且不增加额外执行状态的敌人牌。</summary>
    private sealed class ExecutionEnemyCard : BaseEnemyCard
    {
        /// <summary>从共享不可变定义创建独立实例。</summary>
        public ExecutionEnemyCard(EnemyCardDefinition definition) : base(definition)
        {
        }
    }

    /// <summary>为领域测试关闭依赖怪物实体 Power 列表的能力钩子。</summary>
    private sealed class NoOpAbilityHooks : IEnemyAbilityHookDispatcher
    {
        /// <inheritdoc />
        public Task AfterComposeAsync(EnemyCardExecutionContext context) => Task.CompletedTask;

        /// <inheritdoc />
        public Task AfterSuccessfulUnitAsync(EnemyCardExecutionContext context) => Task.CompletedTask;
    }

    /// <summary>只允许准备，用于证明投影和执行重验不会重新选择分支。</summary>
    private sealed class PlanOnlyCondition : IEnemyCardPlayCondition
    {
        public string ProgramId => "TEST:PLAY_CONDITION:PLAN_ONLY";

        public bool CanPlan(EnemyPreparedPlanningState state, BaseEnemyCard card) => true;

        public bool CanSimulate(EnemyCardSimulationContext context) => false;

        public bool CanExecute(EnemyCardExecutionContext context) => false;
    }

    /// <summary>提供不会被当前 seam 路径调用的空战斗状态接口代理。</summary>
    public class NullCombatStateProxy : DispatchProxy
    {
        /// <summary>为未调用的接口成员返回其返回类型默认值。</summary>
        protected override object? Invoke(MethodInfo? targetMethod, object?[]? args) =>
            targetMethod?.ReturnType.IsValueType == true
                ? Activator.CreateInstance(targetMethod.ReturnType)
                : null;
    }

    /// <summary>提供不依赖真实战斗实体的最小卡牌 Intent 怪物模型。</summary>
    private sealed class HarnessMonster : BaseCardIntentMonsterModel
    {
        /// <summary>捕获生产日志边界收到的全部卡牌 Intent 错误。</summary>
        public List<string> ErrorMessages { get; } = [];

        /// <inheritdoc />
        public override int MinInitialHp => 1;

        /// <inheritdoc />
        public override int MaxInitialHp => MinInitialHp;

        /// <inheritdoc />
        public override string? CustomVisualPath => null;

        /// <inheritdoc />
        protected override MonsterMoveStateMachine GenerateMoveStateMachine() => null!;

        /// <inheritdoc />
        protected override void LogCardIntentError(string message)
        {
            ErrorMessages.Add(message);
        }
    }
}
