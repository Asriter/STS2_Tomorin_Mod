using STS2_Tomorin_Mod.Enemy.CardIntents;
using STS2_Tomorin_Mod.Enemy.CardIntents.Test;
using Xunit;

namespace CardIntentHarness;

/// <summary>
/// 验证通用规划规则和来源牌静态评分契约。
/// </summary>
public sealed class PlanningRulesTests
{
    /// <summary>
    /// 防止心之壁参数自赋值，使静态心之壁收益静默变为零。
    /// </summary>
    [Fact]
    public void HeartWallIsStoredAndContributesItsConfiguredWeight()
    {
        EnemyCardScoreProfile profile = new(atField: 5m);

        EnemyCardScore score = new EnemyCardScoreCalculator().CalculateProfiles([profile]);

        Assert.Equal(15m, score.Total);
        Assert.NotEqual(decimal.Zero, score.Total);
    }

    /// <summary>
    /// 防止静态公式遗漏任一种来源牌贡献，或错误改变攻击分量。
    /// </summary>
    [Fact]
    public void StaticScoreUsesEveryConfiguredContribution()
    {
        EnemyCardScoreProfile profile = new(
            attack: 10m,
            block: 20m,
            buffPowerStacks: 5m,
            strength: 2m,
            dexterity: 3m,
            atField: 4m,
            vulnerable: 6m,
            otherDebuff: 7m,
            normalCollection: 8m,
            starStone: 9m,
            abilityHint: 10m,
            deferredTokenHint: 11m);

        EnemyCardScore score = new EnemyCardScoreCalculator().CalculateProfiles([profile]);

        Assert.Equal(10m, score.Attack);
        Assert.Equal(239.5m, score.Total);
    }

    /// <summary>
    /// 防止无效权重或重复行动指标进入通用规划规则。
    /// </summary>
    [Fact]
    public void WeightedRecipesRejectDuplicateMetricsAndNonPositiveWeights()
    {
        EnemyActionRecipe recipe = new(EnemyActionMetric.Gain, [EnemyCardTag.Defense]);

        Assert.Throws<ArgumentOutOfRangeException>(() =>
            new EnemyWeightedActionRecipe(recipe, weight: 0));
        Assert.Throws<ArgumentException>(() => new EnemyCardPlanningRules(
            new EnemySoftLockLimits(1m, 1m),
            new EnemySoftLockLimits(1m, 1m),
            maxCandidateAttempts: 3,
            stepLimit: 256,
            recipes:
            [
                new EnemyWeightedActionRecipe(recipe, 1),
                new EnemyWeightedActionRecipe(recipe, 1)
            ]));
    }

    /// <summary>
    /// 防止无效基础配置或无法传给随机源的聚合权重进入战斗规划阶段。
    /// </summary>
    [Fact]
    public void PlanningRulesRejectInvalidBoundsEmptyRecipesAndAggregateWeightOverflow()
    {
        EnemyActionRecipe recipe = new(EnemyActionMetric.Gain, [EnemyCardTag.Defense]);
        EnemyWeightedActionRecipe weightedRecipe = new(recipe, 1);
        EnemySoftLockLimits limits = new(1m, 1m);

        Assert.Throws<ArgumentException>(() => new EnemyCardPlanningRules(
            limits,
            limits,
            maxCandidateAttempts: 1,
            stepLimit: 1,
            recipes: []));
        Assert.Throws<ArgumentOutOfRangeException>(() => new EnemyCardPlanningRules(
            limits,
            limits,
            maxCandidateAttempts: 0,
            stepLimit: 1,
            recipes: [weightedRecipe]));
        Assert.Throws<ArgumentOutOfRangeException>(() => new EnemyCardPlanningRules(
            limits,
            limits,
            maxCandidateAttempts: 1,
            stepLimit: 0,
            recipes: [weightedRecipe]));

        ArgumentOutOfRangeException overflow = Assert.Throws<ArgumentOutOfRangeException>(() =>
            new EnemyCardPlanningRules(
                limits,
                limits,
                maxCandidateAttempts: 1,
                stepLimit: 1,
                recipes:
                [
                    new EnemyWeightedActionRecipe(recipe, int.MaxValue),
                    new EnemyWeightedActionRecipe(
                        new EnemyActionRecipe(EnemyActionMetric.Attack, [EnemyCardTag.Attack]),
                        1)
                ]));

        Assert.Equal("recipes", overflow.ParamName);
    }

    /// <summary>
    /// 防止兼容测试规则改变公开构造参数的异常参数名。
    /// </summary>
    [Fact]
    public void TestRulesPreserveInitialStarStoneCountParameterName()
    {
        ArgumentOutOfRangeException exception = Assert.Throws<ArgumentOutOfRangeException>(() =>
            new CardIntentTestRules(
                attackLock: 1m,
                totalScoreLock: 1m,
                maxCandidateAttempts: 1,
                recipes: [new EnemyActionRecipe(EnemyActionMetric.Gain, [EnemyCardTag.Defense])],
                initialStarStoneCount: -1));

        Assert.Equal("initialStarStoneCount", exception.ParamName);
    }
}
