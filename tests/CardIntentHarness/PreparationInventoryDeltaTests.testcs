using MegaCrit.Sts2.Core.Entities.Cards;
using System.Reflection;
using STS2_Tomorin_Mod.Cards;
using STS2_Tomorin_Mod.Enemy.CardIntents;
using STS2_Tomorin_Mod.Enemy.CardIntents.Test;
using Xunit;

namespace CardIntentHarness;

/// <summary>
/// 验证一次准备周期只冻结一份收藏品增量，并把它与最终行动原子提交。
/// </summary>
public sealed class PreparationInventoryDeltaTests
{
    /// <summary>
    /// 前两个候选被软锁拒绝时仍共享同一冻结收藏品，第三个候选只能提交一次增量。
    /// </summary>
    [Fact]
    public void ThreeCandidateAttemptsShareOneFrozenCollectionAndCommitItOnce()
    {
        PreparationFixture fixture = PreparationFixture.WithRejectedFirstAndSecondCandidates();

        PreparedEnemyCardAction action = fixture.Planner.Prepare(fixture.State, fixture.Context);

        Assert.Equal(3, action.SoftLockDiagnostic.CandidateAttemptCount);
        Assert.Null(Assert.Single(action.Sources).TruncationAttemptIndex);
        EnemyCollectionInstance added = Assert.Single(action.PreActionInventoryDelta.AddedAvailable);
        Assert.Same(added, Assert.Single(
            fixture.State.CollectionQueue,
            instance => instance.CollectionInstanceId == added.CollectionInstanceId));
        Assert.Equal(1, fixture.Random.CollectionSelectionCalls);
        Assert.Same(added, fixture.State.FrozenPreparationCollection);
        Assert.Same(action.PreActionInventoryDelta, fixture.State.FrozenPreparationDelta);
    }

    /// <summary>
    /// 所有候选都无法填满配方时进入故障诊断，但冻结增量不能提前进入权威库存。
    /// </summary>
    [Fact]
    public void FailedPreparationKeepsFrozenDiagnosticButDoesNotMutateInventory()
    {
        PreparationFixture fixture = PreparationFixture.WithAllIncompleteCandidates();
        int before = fixture.State.CollectionQueue.Count;

        EnemyCandidatePlanningException exception = Assert.Throws<EnemyCandidatePlanningException>(() =>
            fixture.Planner.Prepare(fixture.State, fixture.Context));

        Assert.Equal(before, fixture.State.CollectionQueue.Count);
        Assert.NotNull(fixture.State.FrozenPreparationDelta);
        Assert.NotNull(fixture.State.FrozenPreparationCollection);
        Assert.NotNull(fixture.State.FaultDiagnostic);
        Assert.Contains("3", exception.Message, StringComparison.Ordinal);
        Assert.Equal(1, fixture.Random.CollectionSelectionCalls);
    }

    /// <summary>
    /// 库存通知只能在 owner 的牌区、行动、指标、阶段和 delta 已全部提交后发布；坏订阅者不得反向破坏提交。
    /// </summary>
    [Fact]
    public void CompoundCommitPublishesCompleteOwnerStateAndIsolatesThrowingSubscribers()
    {
        PreparationFixture fixture = PreparationFixture.WithRejectedFirstAndSecondCandidates();
        bool laterSubscriberRan = false;
        PreparedEnemyCardAction? observedAction = null;
        EnemyCardRuntimePhase observedPhase = EnemyCardRuntimePhase.Idle;
        EnemyActionMetric? observedMetric = null;
        EnemyCardInstanceKey[] observedCurrent = [];
        EnemyCollectionInstance[] observedAvailable = [];
        fixture.State.CollectionInventory.InventoryChanged += (_, _) =>
        {
            observedAction = fixture.State.PreparedAction;
            observedPhase = fixture.State.RuntimePhase;
            observedMetric = fixture.State.LastMetric;
            observedCurrent = fixture.State.CurrentCards.Select(card => card.InstanceKey).ToArray();
            observedAvailable = fixture.State.CollectionInventory.Available.ToArray();
            throw new InvalidOperationException("expected observer failure");
        };
        fixture.State.CollectionInventory.InventoryChanged += (_, _) => laterSubscriberRan = true;

        PreparedEnemyCardAction action = fixture.Planner.Prepare(fixture.State, fixture.Context);

        Assert.Same(action, fixture.State.PreparedAction);
        Assert.Same(action, observedAction);
        Assert.Equal(EnemyCardRuntimePhase.Prepared, observedPhase);
        Assert.Equal(action.Metric, observedMetric);
        Assert.Equal(action.MetricCards.Select(card => card.InstanceKey), observedCurrent);
        Assert.Same(
            Assert.Single(action.PreActionInventoryDelta.AddedAvailable),
            Assert.Single(observedAvailable));
        Assert.True(laterSubscriberRan);
        Assert.Single(fixture.State.CollectionInventory.LastNotificationExceptions);
    }

    /// <summary>事务入口拒绝无效库存目标时不能调用 owner commit，也不能改变库存。</summary>
    [Fact]
    public void InvalidInventoryTargetDoesNotInvokeOwnerCommitOrMutateInventory()
    {
        EnemyCollectionInventory inventory = new();
        EnemyCollectionDefinition definition = CardIntentTestCollectionCatalog.Catalog.GetRequired(
            CardIntentTestCollectionCatalog.StarStoneId);
        EnemyCollectionInstance existing = inventory.Append(definition);
        EnemyCollectionInventorySnapshot before = inventory.CaptureSnapshot();
        EnemyCollectionInventorySnapshot invalid = new([existing], [existing], nextSequence: 1);
        bool ownerCommitted = false;

        MethodInfo transaction = typeof(EnemyCollectionInventory).GetMethod(
            "TryCommitSnapshotAtomically",
            BindingFlags.Instance | BindingFlags.NonPublic) ?? throw new MissingMethodException(
            nameof(EnemyCollectionInventory),
            "TryCommitSnapshotAtomically");
        object?[] arguments =
        [
            invalid,
            (Action)(() => ownerCommitted = true),
            (Action)(() => throw new InvalidOperationException("rollback must not run")),
            true,
            string.Empty
        ];
        bool committed = Assert.IsType<bool>(transaction.Invoke(inventory, arguments));
        string reason = Assert.IsType<string>(arguments[4]);

        Assert.False(committed);
        Assert.False(ownerCommitted);
        Assert.NotEmpty(reason);
        Assert.Equal(before.Available, inventory.Available);
        Assert.Equal(before.Consumed, inventory.Consumed);
        Assert.Equal(before.NextSequence, inventory.NextSequence);
    }

    /// <summary>owner 已部分交换后抛出时，事务必须恢复 owner 全字段与库存，且不发布事件。</summary>
    [Fact]
    public void OwnerCommitExceptionRollsBackInventoryAndSkipsNotification()
    {
        EnemyCollectionInventory inventory = new();
        EnemyCollectionDefinition definition = CardIntentTestCollectionCatalog.Catalog.GetRequired(
            CardIntentTestCollectionCatalog.StarStoneId);
        EnemyCollectionInventorySnapshot before = inventory.CaptureSnapshot();
        EnemyCollectionInstance added = new(definition, before.NextSequence);
        EnemyCollectionInventorySnapshot target = new([added], [], before.NextSequence + 1);
        List<string> draw = ["DRAW_0", "DRAW_1"];
        List<string> current = ["CURRENT_0"];
        List<string> discard = ["DISCARD_0", "DISCARD_1"];
        string[] beforeDraw = draw.ToArray();
        string[] beforeCurrent = current.ToArray();
        string[] beforeDiscard = discard.ToArray();
        object? preparedAction = null;
        EnemyActionMetric? lastMetric = EnemyActionMetric.Gain;
        EnemyCardRuntimePhase runtimePhase = EnemyCardRuntimePhase.Idle;
        int notifications = 0;
        inventory.InventoryChanged += (_, _) => notifications++;
        MethodInfo transaction = typeof(EnemyCollectionInventory).GetMethod(
            "TryCommitSnapshotAtomically",
            BindingFlags.Instance | BindingFlags.NonPublic) ?? throw new MissingMethodException(
            nameof(EnemyCollectionInventory),
            "TryCommitSnapshotAtomically");
        object?[] arguments =
        [
            target,
            (Action)(() =>
            {
                draw.Clear();
                draw.Add("AFTER_DRAW");
                current.Clear();
                current.Add("AFTER_CURRENT");
                discard.Clear();
                preparedAction = new object();
                lastMetric = EnemyActionMetric.Burst;
                runtimePhase = EnemyCardRuntimePhase.Prepared;
                throw new InvalidOperationException("expected owner failure");
            }),
            (Action)(() =>
            {
                draw.Clear();
                draw.AddRange(beforeDraw);
                current.Clear();
                current.AddRange(beforeCurrent);
                discard.Clear();
                discard.AddRange(beforeDiscard);
                preparedAction = null;
                lastMetric = EnemyActionMetric.Gain;
                runtimePhase = EnemyCardRuntimePhase.Idle;
            }),
            true,
            string.Empty
        ];

        TargetInvocationException exception = Assert.Throws<TargetInvocationException>(() =>
            transaction.Invoke(inventory, arguments));

        Assert.IsType<InvalidOperationException>(exception.InnerException);
        Assert.Equal(beforeDraw, draw);
        Assert.Equal(beforeCurrent, current);
        Assert.Equal(beforeDiscard, discard);
        Assert.Null(preparedAction);
        Assert.Equal(EnemyActionMetric.Gain, lastMetric);
        Assert.Equal(EnemyCardRuntimePhase.Idle, runtimePhase);
        Assert.Equal(before.Available, inventory.Available);
        Assert.Equal(before.Consumed, inventory.Consumed);
        Assert.Equal(before.NextSequence, inventory.NextSequence);
        Assert.Equal(0, notifications);
    }

    /// <summary>owner rollback 自身失败时必须保留原 commit 异常并聚合 rollback 诊断，inventory 仍回滚且不通知。</summary>
    [Fact]
    public void OwnerRollbackFailureAggregatesOriginalErrorAndStillRollsBackInventory()
    {
        EnemyCollectionInventory inventory = new();
        EnemyCollectionDefinition definition = CardIntentTestCollectionCatalog.Catalog.GetRequired(
            CardIntentTestCollectionCatalog.StarStoneId);
        EnemyCollectionInventorySnapshot before = inventory.CaptureSnapshot();
        EnemyCollectionInstance added = new(definition, before.NextSequence);
        EnemyCollectionInventorySnapshot target = new([added], [], before.NextSequence + 1);
        int notifications = 0;
        inventory.InventoryChanged += (_, _) => notifications++;
        MethodInfo transaction = typeof(EnemyCollectionInventory).GetMethod(
            "TryCommitSnapshotAtomically",
            BindingFlags.Instance | BindingFlags.NonPublic) ?? throw new MissingMethodException(
            nameof(EnemyCollectionInventory),
            "TryCommitSnapshotAtomically");
        object?[] arguments =
        [
            target,
            (Action)(() => throw new InvalidOperationException("original commit failure")),
            (Action)(() => throw new ApplicationException("owner rollback failure")),
            true,
            string.Empty
        ];

        TargetInvocationException wrapper = Assert.Throws<TargetInvocationException>(() =>
            transaction.Invoke(inventory, arguments));
        AggregateException aggregate = Assert.IsType<AggregateException>(wrapper.InnerException);

        Assert.Collection(
            aggregate.InnerExceptions,
            original => Assert.Equal("original commit failure", original.Message),
            rollback => Assert.Equal("owner rollback failure", rollback.Message));
        Assert.Equal(before.Available, inventory.Available);
        Assert.Equal(before.Consumed, inventory.Consumed);
        Assert.Equal(before.NextSequence, inventory.NextSequence);
        Assert.Equal(0, notifications);
    }

    /// <summary>冻结周期必须在写诊断字段前拒绝与 live available/consumed 冲突的 delta。</summary>
    [Theory]
    [InlineData(false)]
    [InlineData(true)]
    public void PreparationDeltaConflictingWithLiveInventoryIsRejectedBeforeFreeze(bool consumeExisting)
    {
        string caseId = consumeExisting.ToString().ToUpperInvariant();
        BaseEnemyCard card = CreateCard($"DELTA_CONFLICT_{caseId}", EnemyCardTag.Attack);
        EnemyCardCombatState state = CreateState($"DELTA_CONFLICT_{caseId}", [card]);
        EnemyCollectionDefinition definition = CardIntentTestCollectionCatalog.Catalog.GetRequired(
            CardIntentTestCollectionCatalog.StarStoneId);
        EnemyCollectionInstance existing = state.CollectionInventory.Append(definition);
        if (consumeExisting)
        {
            state.CollectionInventory.Consume(existing);
        }

        EnemyCollectionInventorySnapshot before = state.CollectionInventory.CaptureSnapshot();
        int factoryCalls = 0;
        EnemyPlanningContext context = new(
            new PreparationRandomSource(Enumerable.Repeat(0, 8)),
            createPreparationCycle: (_, _) =>
            {
                factoryCalls++;
                EnemyCollectionInstance conflicting = new(definition, existing.Sequence);
                return new EnemyPreparationCycle(
                    conflicting,
                    new EnemyPreparedPreActionInventoryDelta([conflicting]));
            });
        EnemyActionMetricPlanner planner = new(
            CreateRules(new EnemyActionRecipe(EnemyActionMetric.Attack, [EnemyCardTag.Attack]), 999m, 1),
            new());

        Assert.Throws<InvalidOperationException>(() => planner.Prepare(state, context));

        Assert.Equal(1, factoryCalls);
        Assert.Null(state.FrozenPreparationCollection);
        Assert.Null(state.FrozenPreparationDelta);
        Assert.Equal(before.Available, state.CollectionInventory.Available);
        Assert.Equal(before.Consumed, state.CollectionInventory.Consumed);
        Assert.Equal(before.NextSequence, state.CollectionInventory.NextSequence);
    }

    /// <summary>候选同时包含超锁与结构不完整时必须 Fault，并在重试前拒绝而不再次选择收藏品。</summary>
    [Fact]
    public void MixedOverLockAndIncompleteAttemptsFaultAndCannotRestartPreparationCycle()
    {
        BaseEnemyCard overLock = new HarnessEnemyCard(new EnemyCardDefinition(
            new EnemyCardId("STS2_TOMORIN_MOD:PREPARATION_MIXED_OVER_LOCK"),
            new StrikeTomorin(),
            EnemyCardTag.Attack,
            new EnemyCardScoreProfile(attack: 11m)));
        EnemyCardCombatState state = CreateState("MIXED_FAILURE", [overLock]);
        EnemyActionRecipe incomplete = new(
            EnemyActionMetric.Gain,
            [new EnemyActionSlotRule(
                EnemyCardTag.Defense,
                new HashSet<EnemyCardId> { new("STS2_TOMORIN_MOD:PREPARATION_MIXED_MISSING") })],
            EnemyCandidateConstraints.Unrestricted);
        EnemyCardPlanningRules rules = new(
            new EnemySoftLockLimits(10m, 999m),
            new EnemySoftLockLimits(10m, 999m),
            maxCandidateAttempts: 2,
            stepLimit: 256,
            [
                new EnemyWeightedActionRecipe(incomplete, 1),
                new EnemyWeightedActionRecipe(new EnemyActionRecipe(EnemyActionMetric.Attack, [null]), 1)
            ]);
        PreparationRandomSource random = new([1, 0, 0]);
        int factoryCalls = 0;
        EnemyPlanningContext context = new(
            random,
            createPreparationCycle: (owner, _) =>
            {
                factoryCalls++;
                EnemyCollectionDefinition definition = CardIntentTestCollectionCatalog.Catalog.GetRequired(
                    CardIntentTestCollectionCatalog.StarStoneId);
                EnemyCollectionInstance added = new(definition, owner.NextCollectionSequence);
                return new EnemyPreparationCycle(added, new EnemyPreparedPreActionInventoryDelta([added]));
            });
        EnemyActionMetricPlanner planner = new(rules, new());

        EnemyCandidatePlanningException exception = Assert.Throws<EnemyCandidatePlanningException>(() =>
            planner.Prepare(state, context));
        Assert.Contains("超锁", exception.Message, StringComparison.Ordinal);
        Assert.Contains("不完整", exception.Message, StringComparison.Ordinal);
        Assert.Equal(EnemyCardRuntimePhase.Faulted, state.RuntimePhase);
        Assert.Empty(state.CollectionInventory.Available);
        Assert.Equal(1, factoryCalls);

        Assert.Throws<InvalidOperationException>(() => planner.Prepare(state, context));
        Assert.Equal(1, factoryCalls);
    }

    /// <summary>
    /// 封装具有确定性牌堆、随机源和准备周期工厂的完整规划输入。
    /// </summary>
    private sealed class PreparationFixture
    {
        private PreparationFixture(
            EnemyCardCombatState state,
            EnemyActionMetricPlanner planner,
            PreparationRandomSource random)
        {
            State = state;
            Planner = planner;
            Random = random;
            Context = new EnemyPlanningContext(
                random,
                createPreparationCycle: CreatePreparationCycle);
        }

        public EnemyCardCombatState State { get; }
        public EnemyActionMetricPlanner Planner { get; }
        public PreparationRandomSource Random { get; }
        public EnemyPlanningContext Context { get; }

        public static PreparationFixture WithRejectedFirstAndSecondCandidates()
        {
            const decimal attackLock = 10m;
            BaseEnemyCard first = CreateComposeCard("DELTA_REJECT_1", attackLock + 2m);
            BaseEnemyCard second = CreateComposeCard("DELTA_REJECT_2", attackLock + 1m);
            BaseEnemyCard third = CreateComposeCard("DELTA_ACCEPT", attackLock);
            EnemyCardCombatState state = CreateState("DELTA_THREE_ATTEMPTS", [first, second, third]);
            EnemyCardPlanningRules rules = CreateRules(
                new EnemyActionRecipe(EnemyActionMetric.ComposeTest, [EnemyCardTag.Compose]),
                attackLock,
                maxCandidateAttempts: 3);
            PreparationRandomSource random = new([0, 0, 0, 1, 0, 2]);
            return new PreparationFixture(state, new EnemyActionMetricPlanner(rules, new()), random);
        }

        public static PreparationFixture WithAllIncompleteCandidates()
        {
            BaseEnemyCard onlyCard = CreateCard("DELTA_INCOMPLETE", EnemyCardTag.Attack);
            EnemyCardCombatState state = CreateState("DELTA_ALL_INCOMPLETE", [onlyCard]);
            EnemyActionRecipe recipe = new(
                EnemyActionMetric.Attack,
                [new EnemyActionSlotRule(
                    EnemyCardTag.Attack,
                    new HashSet<EnemyCardId>
                    {
                        new("STS2_TOMORIN_MOD:PREPARATION_REQUIRED_BUT_MISSING")
                    })],
                EnemyCandidateConstraints.Unrestricted);
            PreparationRandomSource random = new(Enumerable.Repeat(0, 16));
            return new PreparationFixture(
                state,
                new EnemyActionMetricPlanner(CreateRules(recipe, 999m, 3), new()),
                random);
        }

        private EnemyPreparationCycle CreatePreparationCycle(
            EnemyCardCombatState state,
            IEnemyCardRandomSource randomSource)
        {
            Assert.Same(Random, randomSource);
            Random.RecordCollectionSelection();
            EnemyCollectionDefinition definition = CardIntentTestCollectionCatalog.Catalog.GetRequired(
                CardIntentTestCollectionCatalog.StarStoneId);
            EnemyCollectionInstance instance = new(definition, state.NextCollectionSequence);
            EnemyPreparedPreActionInventoryDelta delta = new([instance]);
            return new EnemyPreparationCycle(instance, delta);
        }
    }

    private static EnemyCardPlanningRules CreateRules(
        EnemyActionRecipe recipe,
        decimal attackLock,
        int maxCandidateAttempts) =>
        new(
            new EnemySoftLockLimits(attackLock, 999m),
            new EnemySoftLockLimits(attackLock, 999m),
            maxCandidateAttempts,
            stepLimit: 256,
            [new EnemyWeightedActionRecipe(recipe, 1)]);

    private static EnemyCardCombatState CreateState(string scope, IReadOnlyList<BaseEnemyCard> cards)
    {
        EnemyCardDeckId deckId = new($"STS2_TOMORIN_MOD:PREPARATION_{scope}_DECK");
        if (!EnemyCardDeckRegistry.IsRegistered(deckId))
        {
            EnemyCardDeckRegistry.Register(
                deckId,
                cards.Select(card => (Func<BaseEnemyCard>)(() => new HarnessEnemyCard(card.Definition))));
        }

        return EnemyCardDeckRegistry.CreateCombatState(deckId);
    }

    private static BaseEnemyCard CreateComposeCard(string suffix, decimal attack) =>
        new HarnessEnemyCard(new EnemyCardDefinition(
            new EnemyCardId($"STS2_TOMORIN_MOD:PREPARATION_{suffix}"),
            new StrikeTomorin(),
            EnemyCardTag.Attack | EnemyCardTag.Compose,
            new EnemyCardScoreProfile(attack: attack),
            materialRequests: [EnemyMaterialRequest.Compose(CardType.Status, 1)]));

    private static BaseEnemyCard CreateCard(string suffix, EnemyCardTag tags) =>
        new HarnessEnemyCard(new EnemyCardDefinition(
            new EnemyCardId($"STS2_TOMORIN_MOD:PREPARATION_{suffix}"),
            new StrikeTomorin(),
            tags,
            EnemyCardScoreProfile.Zero));

    private sealed class HarnessEnemyCard : BaseEnemyCard
    {
        public HarnessEnemyCard(EnemyCardDefinition definition) : base(definition)
        {
        }
    }

    /// <summary>
    /// 区分普通规划随机请求与准备周期收藏品选择次数。
    /// </summary>
    private sealed class PreparationRandomSource : IEnemyCardRandomSource
    {
        private readonly Queue<int> _indices;

        public PreparationRandomSource(IEnumerable<int> indices)
        {
            _indices = new Queue<int>(indices);
        }

        public int CollectionSelectionCalls { get; private set; }

        public int NextIndex(int exclusiveUpperBound)
        {
            int value = _indices.Count > 0 ? _indices.Dequeue() : 0;
            return Math.Abs(value % exclusiveUpperBound);
        }

        public void RecordCollectionSelection() => CollectionSelectionCalls++;
    }
}
