using MegaCrit.Sts2.Core.Entities.Cards;
using STS2_Tomorin_Mod.Cards;
using STS2_Tomorin_Mod.Enemy.CardIntents;
using STS2_Tomorin_Mod.Enemy.CardIntents.Test;
using Xunit;

namespace CardIntentHarness;

/// <summary>
/// 验证当前版本的主机权威重连状态能够完整往返，并在损坏输入下保持原状态不变。
/// </summary>
public sealed class ReconnectStateTests
{
    /// <summary>
    /// 验证五牌区、重放、收藏品和安全步骤游标会按稳定身份无随机地往返。
    /// </summary>
    [Fact]
    public void RuntimeStateRoundTripPreservesAuthoritativeIdentityAndCursor()
    {
        CardIntentTestDeck.EnsureRegistered();
        EnemyCardCombatState source = EnemyCardDeckRegistry.CreateCombatState(CardIntentTestDeck.DeckId);
        BaseEnemyCard current = source.DrawPile[0];
        BaseEnemyCard retained = source.DrawPile[1];
        BaseEnemyCard discard = source.DrawPile[2];
        BaseEnemyCard exhaust = source.DrawPile[3];
        current.IncreaseReplayCount();
        source.MoveCard(current.InstanceKey, EnemyCardZone.Current);
        source.MoveCard(retained.InstanceKey, EnemyCardZone.Retained);
        source.MoveCard(discard.InstanceKey, EnemyCardZone.Discard);
        source.MoveCard(exhaust.InstanceKey, EnemyCardZone.Exhaust);
        EnemyCollectionDefinition collection = CardIntentTestCollectionCatalog.Catalog.Definitions[0];
        EnemyCollectionInstance consumed = source.CollectionInventory.Append(collection);
        source.CollectionInventory.Consume(consumed);
        source.CollectionInventory.Append(CardIntentTestCollectionCatalog.Catalog.Definitions[1]);
        EnemyCardExecutionCursor cursor = new()
        {
            SourceIndex = source.CurrentCards.Count,
            ReplayIndex = current.ReplayCount,
            CommittedStepCount = source.DiscardPile.Count,
            IsCompleted = false
        };
        cursor.SetStepPath([source.RetainedCards.Count]);

        EnemyCardRuntimeSyncState sync = EnemyCardRuntimeSynchronizer.Capture("TEST_STATE", source, cursor);
        bool restored = EnemyCardRuntimeSynchronizer.TryRestore(
            sync,
            CardIntentTestDeck.DeckId,
            CardIntentTestCardCatalog.AllDefinitions,
            CardIntentTestCollectionCatalog.Catalog,
            out EnemyCardCombatState? target,
            out EnemyCardExecutionCursor? restoredCursor,
            out string reason);

        Assert.True(restored, reason);
        Assert.NotNull(target);
        Assert.Equal(source.DrawPile.Select(card => card.InstanceKey), target!.DrawPile.Select(card => card.InstanceKey));
        Assert.Equal(source.CurrentCards.Select(card => card.InstanceKey), target.CurrentCards.Select(card => card.InstanceKey));
        Assert.Equal(source.RetainedCards.Select(card => card.InstanceKey), target.RetainedCards.Select(card => card.InstanceKey));
        Assert.Equal(source.DiscardPile.Select(card => card.InstanceKey), target.DiscardPile.Select(card => card.InstanceKey));
        Assert.Equal(source.ExhaustPile.Select(card => card.InstanceKey), target.ExhaustPile.Select(card => card.InstanceKey));
        Assert.Equal(current.ReplayCount, target.CurrentCards.Single().ReplayCount);
        Assert.Equal(
            source.CollectionInventory.Available.Select(item => item.CollectionInstanceId),
            target.CollectionInventory.Available.Select(item => item.CollectionInstanceId));
        Assert.Equal(
            source.CollectionInventory.Consumed.Select(item => item.CollectionInstanceId),
            target.CollectionInventory.Consumed.Select(item => item.CollectionInstanceId));
        Assert.NotSame(cursor, restoredCursor);
        Assert.Equal(cursor.SourceIndex, restoredCursor!.SourceIndex);
        Assert.Equal(cursor.ReplayIndex, restoredCursor.ReplayIndex);
        Assert.Equal(cursor.StepPath, restoredCursor.StepPath);
        Assert.Equal(cursor.CommittedStepCount, restoredCursor.CommittedStepCount);
        Assert.Equal(cursor.IsCompleted, restoredCursor.IsCompleted);
    }

    /// <summary>
    /// 验证重复实例身份会被临时恢复校验整体拒绝，既不推进随机也不产生半成品状态。
    /// </summary>
    [Fact]
    public void CorruptedDuplicateIdentityIsRejectedBeforeAnyStateCanBeApplied()
    {
        CardIntentTestDeck.EnsureRegistered();
        EnemyCardCombatState source = EnemyCardDeckRegistry.CreateCombatState(CardIntentTestDeck.DeckId);
        EnemyCardRuntimeSyncState valid = EnemyCardRuntimeSynchronizer.Capture("TEST_STATE", source, null);
        EnemyCardRuntimeCardState duplicate = valid.DrawPile[0];
        EnemyCardRuntimeSyncState corrupted = valid with
        {
            CurrentCards = valid.CurrentCards.Concat([duplicate]).ToArray()
        };

        bool restored = EnemyCardRuntimeSynchronizer.TryRestore(
            corrupted,
            CardIntentTestDeck.DeckId,
            CardIntentTestCardCatalog.AllDefinitions,
            CardIntentTestCollectionCatalog.Catalog,
            out EnemyCardCombatState? target,
            out _,
            out string reason);

        Assert.False(restored);
        Assert.Null(target);
        Assert.False(string.IsNullOrWhiteSpace(reason));
        Assert.Equal(valid.DrawPile.Count, source.DrawPile.Count);
        Assert.Empty(source.CurrentCards);
    }

    /// <summary>
    /// 验证旧结构版本与越界游标均会被拒绝，调用方只能向主机请求重发当前版本数据。
    /// </summary>
    [Fact]
    public void OldSchemaAndUnsafeCursorAreRejected()
    {
        CardIntentTestDeck.EnsureRegistered();
        EnemyCardCombatState source = EnemyCardDeckRegistry.CreateCombatState(CardIntentTestDeck.DeckId);
        EnemyCardRuntimeSyncState valid = EnemyCardRuntimeSynchronizer.Capture("TEST_STATE", source, null);
        EnemyCardRuntimeSyncState oldSchema = valid with
        {
            SchemaVersion = EnemyCardRuntimeSyncState.CurrentSchemaVersion - 1
        };
        EnemyCardRuntimeSyncState unsafeCursor = valid with
        {
            Cursor = new EnemyCardExecutionCursor { SourceIndex = -1 }
        };

        Assert.False(TryRestore(oldSchema, out _));
        Assert.False(TryRestore(unsafeCursor, out _));
    }

    /// <summary>
    /// 验证准备行动的递归单元和显式步骤种类可以往返，未知步骤种类会整体拒绝。
    /// </summary>
    [Fact]
    public void PreparedRecursivePlanRoundTripsAndRejectsUnknownStepKind()
    {
        CardIntentTestDeck.EnsureRegistered();
        EnemyCardCombatState source = EnemyCardDeckRegistry.CreateCombatState(CardIntentTestDeck.DeckId);
        EnemyActionMetricPlanner planner = new(
            CardIntentTestRules.Default,
            new EnemyCardScoreCalculator());
        PreparedEnemyCardAction action = planner.Prepare(
            source,
            new EnemyPlanningContext(new ZeroRandomSource()));
        PreparedEnemyCardSource sourcePlan = action.Sources.First(item => item.Units.Count > 0);
        EnemyCardExecutionCursor cursor = new()
        {
            SourceIndex = action.Sources.ToList().IndexOf(sourcePlan),
            ReplayIndex = sourcePlan.Units[0].ReplayIndex,
            CommittedStepCount = 0
        };
        cursor.SetStepPath([0]);

        EnemyCardRuntimeSyncState sync = EnemyCardRuntimeSynchronizer.Capture("RECURSIVE_PLAN", source, cursor);
        Assert.True(TryRestore(sync, out string roundTripReason), roundTripReason);
        PreparedEnemyCardUnitPlanSyncState transferUnit = sync.PreparedAction!.Sources
            .Single(item => item.SourceInstanceKey == sourcePlan.SourceKey.Value)
            .Units[0];
        PreparedEnemyResolutionStepSyncState unknown = transferUnit.OrderedSteps[0] with
        {
            Kind = (PreparedEnemyResolutionStepSyncKind)int.MaxValue
        };
        PreparedEnemyCardUnitPlanSyncState corruptedUnit = transferUnit with
        {
            OrderedSteps = [unknown, .. transferUnit.OrderedSteps.Skip(1)]
        };
        PreparedEnemyCardSourceSyncState corruptedSource = sync.PreparedAction.Sources
            .Single(item => item.SourceInstanceKey == sourcePlan.SourceKey.Value) with
        {
            Units = [corruptedUnit, .. sync.PreparedAction.Sources
                .Single(item => item.SourceInstanceKey == sourcePlan.SourceKey.Value).Units.Skip(1)]
        };
        PreparedEnemyCardActionSyncState corruptedAction = sync.PreparedAction with
        {
            Sources = sync.PreparedAction.Sources
                .Select(item => item.SourceInstanceKey == corruptedSource.SourceInstanceKey
                    ? corruptedSource
                    : item)
                .ToArray()
        };

        Assert.False(TryRestore(sync with { PreparedAction = corruptedAction }, out _));

        EnemyCardExecutionCursor outOfBounds = cursor.Clone();
        outOfBounds.SetStepPath([sourcePlan.Units[0].OrderedSteps.Count + 1]);
        Assert.False(TryRestore(sync with { Cursor = outOfBounds }, out _));
    }

    [Fact]
    public void SchemaV3RoundTripPreservesPhaseCarryExhaustFrozenXAndPreparation()
    {
        PhaseReconnectFixture fixture = PhaseReconnectFixture.Create("ROUND_TRIP");
        EnemyCardRuntimeSyncState sync = fixture.Capture();

        Assert.True(fixture.TryRestore(sync, out EnemyCardCombatState? restored, out string reason), reason);
        Assert.NotNull(restored);
        Assert.Equal(EnemyCardRuntimeSyncState.CurrentSchemaVersion, sync.SchemaVersion);
        Assert.Equal(fixture.State.ActivePhase, restored!.ActivePhase);
        Assert.Equal(fixture.State.PendingPhase, restored.PendingPhase);
        Assert.Equal(fixture.State.PhaseRevision, restored.PhaseRevision);
        Assert.Equal(
            fixture.Carry.InstanceKey,
            restored.ExhaustPile.Single(card => card.CarryAcrossPhase).InstanceKey);
        Assert.Equal(EnemyCardPhase.Phase1, restored.ExhaustPile.Single(card => card.CarryAcrossPhase).SourcePhase);
        Assert.NotNull(restored.FrozenPreparationCollection);
        Assert.NotNull(restored.FrozenPreparationDelta);
        Assert.Same(
            restored.FrozenPreparationCollection,
            Assert.Single(restored.FrozenPreparationDelta!.AddedAvailable));
        Assert.Same(
            restored.FrozenPreparationDelta,
            restored.PreparedAction!.PreActionInventoryDelta);
        Assert.Equal(EnemyCardPhase.Phase2, restored.PreparedAction.Phase);
        EnemyFrozenEffectiveCardState frozen = Assert.Single(restored.PreparedAction.EffectiveCardStates).Value;
        Assert.NotNull(frozen.FrozenX);
        Assert.True(frozen.WasCounted);
        Assert.Equal(sync.CompletedEffectiveCardCount, restored.PreparedAction.EffectiveCardStates.Values.Count(x => x.WasCounted));
        Assert.Equal(sync.StaticScore!.Attack, restored.PreparedAction.SoftLockDiagnostic.StaticScore.Attack);
        Assert.Equal(sync.FullScore!.AttackRisk, restored.PreparedAction.SoftLockDiagnostic.FullScore.AttackRisk);
        Assert.Equal(sync.CommitMode, restored.PreparedAction.SoftLockDiagnostic.CommitMode);
    }

    [Fact]
    public void MissingRequiredFrozenXIsRejectedWithoutChangingAuthority()
    {
        PhaseReconnectFixture fixture = PhaseReconnectFixture.Create("MISSING_X");
        EnemyCardRuntimeSyncState valid = fixture.Capture();
        EnemyFrozenEffectiveCardSyncState xState = valid.EffectiveCardStates.Single(item => item.FrozenX.HasValue);
        EnemyCardRuntimeSyncState corrupt = valid with
        {
            EffectiveCardStates = valid.EffectiveCardStates
                .Select(item => item.ExecutingCardInstanceKey == xState.ExecutingCardInstanceKey
                    ? item with { FrozenX = null }
                    : item)
                .ToArray()
        };
        EnemyCardInstanceKey[] exhaustBefore = fixture.State.ExhaustPile.Select(card => card.InstanceKey).ToArray();
        PreparedEnemyCardAction actionBefore = fixture.State.PreparedAction!;
        EnemyCollectionInstance preparationBefore = fixture.State.FrozenPreparationCollection!;

        Assert.False(fixture.TryRestore(corrupt, out EnemyCardCombatState? restored, out string reason));
        Assert.Null(restored);
        Assert.Contains("X", reason, StringComparison.OrdinalIgnoreCase);
        Assert.Equal(exhaustBefore, fixture.State.ExhaustPile.Select(card => card.InstanceKey));
        Assert.Same(actionBefore, fixture.State.PreparedAction);
        Assert.Same(preparationBefore, fixture.State.FrozenPreparationCollection);
        Assert.Equal(EnemyCardPhase.Phase2, fixture.State.ActivePhase);
        Assert.Equal(EnemyCardPhase.Phase3, fixture.State.PendingPhase);
    }

    [Fact]
    public void CorruptSchemaV3ClosuresAreRejected()
    {
        PhaseReconnectFixture fixture = PhaseReconnectFixture.Create("CORRUPT_CLOSURE");
        EnemyCardRuntimeSyncState valid = fixture.Capture();
        PreparedEnemyCardAction actionBefore = fixture.State.PreparedAction!;
        EnemyCollectionInstance preparationBefore = fixture.State.FrozenPreparationCollection!;
        EnemyCardRuntimeCardState carry = valid.ExhaustPile.Single(card => card.CarryAcrossPhase);
        EnemyCardRuntimeSyncState corruptCarry = valid with
        {
            ExhaustPile = valid.ExhaustPile
                .Select(card => card.InstanceKey == carry.InstanceKey
                    ? card with { CarryAcrossPhase = false }
                    : card)
                .ToArray()
        };
        EnemyCardRuntimeSyncState duplicateEffective = valid with
        {
            EffectiveCardStates = [.. valid.EffectiveCardStates, valid.EffectiveCardStates[0]]
        };
        EnemySoftLockDiagnosticSyncState forcedDiagnostic = valid.PreparedAction!.SoftLockDiagnostic! with
        {
            WasForcedByAttemptLimit = true
        };
        EnemyCardRuntimeSyncState incompleteForced = valid with
        {
            CommitMode = EnemyCandidateCommitMode.ForcedOverLock,
            ProjectionIsComplete = false,
            PreparedAction = valid.PreparedAction with { SoftLockDiagnostic = forcedDiagnostic }
        };

        Assert.False(fixture.TryRestore(corruptCarry, out _, out _));
        Assert.False(fixture.TryRestore(duplicateEffective, out _, out _));
        Assert.False(fixture.TryRestore(incompleteForced, out _, out _));
        Assert.Same(actionBefore, fixture.State.PreparedAction);
        Assert.Same(preparationBefore, fixture.State.FrozenPreparationCollection);
        Assert.Equal(EnemyCardPhase.Phase2, fixture.State.ActivePhase);
        Assert.Equal(EnemyCardPhase.Phase3, fixture.State.PendingPhase);
    }

    /// <summary>
    /// 使用测试敌人的显式目录尝试恢复一个传输状态。
    /// </summary>
    private static bool TryRestore(EnemyCardRuntimeSyncState sync, out string reason) =>
        EnemyCardRuntimeSynchronizer.TryRestore(
            sync,
            CardIntentTestDeck.DeckId,
            CardIntentTestCardCatalog.AllDefinitions,
            CardIntentTestCollectionCatalog.Catalog,
            out _,
            out _,
            out reason);

    /// <summary>
    /// 为递归同步测试提供始终选择首个候选的确定性随机源。
    /// </summary>
    private sealed class ZeroRandomSource : IEnemyCardRandomSource
    {
        /// <inheritdoc />
        public int NextIndex(int exclusiveUpperBound) => 0;
    }

    private sealed class PhaseReconnectFixture
    {
        private static int _nextId;

        private PhaseReconnectFixture(
            EnemyCardContentDirectory directory,
            EnemyCardCombatState state,
            BaseEnemyCard carry)
        {
            Directory = directory;
            State = state;
            Carry = carry;
        }

        public EnemyCardContentDirectory Directory { get; }
        public EnemyCardCombatState State { get; }
        public BaseEnemyCard Carry { get; }

        public static PhaseReconnectFixture Create(string suffix)
        {
            int id = Interlocked.Increment(ref _nextId);
            StrikeTomorin model = new();
            EnemyCardDefinition carryDefinition = new(
                new EnemyCardId($"STS2_TOMORIN_MOD:SYNC_CARRY_{suffix}_{id}"),
                model,
                EnemyCardTag.Attack,
                new EnemyCardScoreProfile(attack: 1m),
                carryAcrossPhase: true);
            EnemyCardDefinition xDefinition = new(
                new EnemyCardId($"STS2_TOMORIN_MOD:SYNC_X_{suffix}_{id}"),
                model,
                EnemyCardTag.Attack,
                EnemyCardScoreProfile.Zero,
                effects: [new EnemyFrozenXAttackAllEffect($"SYNC:X:{suffix}:{id}", 3m)]);
            EnemyCardDefinition thirdDefinition = new(
                new EnemyCardId($"STS2_TOMORIN_MOD:SYNC_P3_{suffix}_{id}"),
                model,
                EnemyCardTag.Attack,
                new EnemyCardScoreProfile(attack: 1m));
            EnemyCardPlanningRules rules = new(
                new EnemySoftLockLimits(decimal.MaxValue, decimal.MaxValue),
                new EnemySoftLockLimits(decimal.MaxValue, decimal.MaxValue),
                maxCandidateAttempts: 1,
                stepLimit: 128,
                [new EnemyWeightedActionRecipe(
                    new EnemyActionRecipe(EnemyActionMetric.Attack, [EnemyCardTag.Attack]),
                    weight: 1)]);
            Func<BaseEnemyCard> CarryFactory() => () => new HarnessEnemyCard(carryDefinition);
            Func<BaseEnemyCard> XFactory() => () => new HarnessEnemyCard(xDefinition);
            Func<BaseEnemyCard> ThirdFactory() => () => new HarnessEnemyCard(thirdDefinition);
            EnemyCollectionDefinition collection = new(
                $"SYNC_COLLECTION_{suffix}_{id}",
                model.GetType(),
                CardType.Status,
                isEpiphany: false,
                $"SYNC_COLLECTION_EFFECT_{suffix}_{id}",
                () => model);
            EnemyCardDeckId deckId = new($"STS2_TOMORIN_MOD:SYNC_PHASE_{suffix}_{id}");
            EnemyCardContentDirectory directory = new(
                deckId,
                EnemyCardPhase.Phase1,
                [
                    new EnemyCardPhaseTemplate(EnemyCardPhase.Phase1, [CarryFactory()], rules, 1),
                    new EnemyCardPhaseTemplate(EnemyCardPhase.Phase2, [XFactory()], rules, 1),
                    new EnemyCardPhaseTemplate(EnemyCardPhase.Phase3, [ThirdFactory()], rules, 1)
                ],
                new Dictionary<EnemyCardId, Func<BaseEnemyCard>>
                {
                    [carryDefinition.CardId] = CarryFactory(),
                    [xDefinition.CardId] = XFactory(),
                    [thirdDefinition.CardId] = ThirdFactory()
                },
                new EnemyCollectionCatalog([collection]));
            EnemyCardDeckRegistry.Register(directory);
            EnemyCardCombatState state = EnemyCardDeckRegistry.CreateCombatState(deckId);
            BaseEnemyCard carry = Assert.Single(state.DrawPile);
            state.MoveCard(carry.InstanceKey, EnemyCardZone.Exhaust);
            state.RequestPhase(EnemyCardPhase.Phase2);
            state.ApplyPhaseTransition(state.BuildPhaseTransitionCandidate(
                directory.GetPhase(EnemyCardPhase.Phase2),
                new ZeroRandomSource()));
            EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());
            planner.Prepare(
                state,
                new EnemyPlanningContext(
                    new ZeroRandomSource(),
                    createPreparationCycle: (owner, _) =>
                    {
                        EnemyCollectionInstance added = new(collection, owner.NextCollectionSequence);
                        return new EnemyPreparationCycle(
                            added,
                            new EnemyPreparedPreActionInventoryDelta([added]));
                    }));
            state.RequestPhase(EnemyCardPhase.Phase3);
            return new PhaseReconnectFixture(directory, state, carry);
        }

        public EnemyCardRuntimeSyncState Capture() =>
            EnemyCardRuntimeSynchronizer.Capture("PHASE_SYNC", State, null);

        public bool TryRestore(
            EnemyCardRuntimeSyncState sync,
            out EnemyCardCombatState? restored,
            out string reason) =>
            EnemyCardRuntimeSynchronizer.TryRestore(
                sync,
                Directory.DeckId,
                Directory.DefinitionFactories.Keys.ToDictionary(
                    cardId => cardId,
                    cardId => Directory.CreateDefinition(cardId).Definition),
                Directory.CollectionCatalog,
                out restored,
                out _,
            out reason);
    }

    private sealed class HarnessEnemyCard(EnemyCardDefinition definition) : BaseEnemyCard(definition);
}
