using STS2_Tomorin_Mod.Enemy.CardIntents;
using STS2_Tomorin_Mod.Powers;
using Xunit;

namespace CardIntentHarness;

public sealed class ShadowTomorinCatalogTests
{
    [Fact]
    public void PhaseTemplatesMatchBalanceAndCarryContract()
    {
        ShadowTomorinDeck.EnsureRegistered();
        EnemyCardContentDirectory directory = EnemyCardDeckRegistry.GetContentDirectory(
            ShadowTomorinDeck.DeckId);

        Assert.Equal(ShadowTomorinBalance.Phase1TemplateCount,
            directory.GetPhase(EnemyCardPhase.Phase1).SourceFactories.Count);
        Assert.Equal(ShadowTomorinBalance.Phase2TemplateCount,
            directory.GetPhase(EnemyCardPhase.Phase2).SourceFactories.Count);
        Assert.Equal(ShadowTomorinBalance.Phase3TemplateCount,
            directory.GetPhase(EnemyCardPhase.Phase3).SourceFactories.Count);
        Assert.DoesNotContain(directory.GetPhase(EnemyCardPhase.Phase1).SourceFactories.Select(factory => factory()),
            card => card.Definition.Tags.HasFlag(EnemyCardTag.Compose));
        Assert.Equal(7, ShadowTomorinCardCatalog.CarryDefinitions.Count);
        Assert.All(ShadowTomorinCardCatalog.CarryDefinitions,
            definition => Assert.True(definition.CarryAcrossPhase));
        Assert.DoesNotContain(ShadowTomorinCardCatalog.AllDefinitions.Values,
            definition => definition.CardId.Value.Contains("UTAKOTOBA", StringComparison.OrdinalIgnoreCase));
    }

    [Fact]
    public void ExactPhaseMultiplicitiesAndCardEffectsAreRegistered()
    {
        AssertPhaseCounts(EnemyCardPhase.Phase1,
            ("SORROWFUL_RAIN", 1), ("ADAYUME", 1), ("HEART_BEAT", 1),
            ("DUCK_AND_COVER", 1), ("NAME_OF_TEAR", 1), ("BUILD_AT_FIELD", 2),
            ("DEFEND", 2), ("STRIKE", 2), ("TOMORIN_PUNCH", 1));
        AssertPhaseCounts(EnemyCardPhase.Phase2,
            ("AT_FIELD", 2), ("CANNOT_BEING_HUMAN", 1), ("WOODLOUSE", 1),
            ("UNWANTED_SIXTH", 1), ("POETRY_OR_LYRICS", 1), ("THIS_NO_NEED", 1),
            ("HOPE_ON_THE_VOICE", 1), ("HITOSHIZUKU", 1), ("WANT_BE_YOUR_GOD", 1),
            ("TOMORIN_PUNCH", 1));
        AssertPhaseCounts(EnemyCardPhase.Phase3,
            ("NAMELESS_PAPER", 2), ("MAYOIUTA", 1), ("HITOSHIZUKU", 1),
            ("SENZAIHYOUMEI", 1), ("SING_FULL_POWER", 1), ("WHY_PLAY_HARUHIKAGE", 1),
            ("TOMORIN_PUNCH", 1), ("WANT_TO_BEING_HUMAN", 1));

        EnemyCardDefinition punch = ShadowTomorinCardCatalog.Get("TOMORIN_PUNCH");
        Assert.Equal(8m, punch.ScoreProfile.Attack);
        Assert.Equal(8m, punch.ScoreProfile.Block);
        Assert.Equal(2m, punch.ScoreProfile.AtField);
        Assert.Equal(EnemyCardFailureDisposition.Retain,
            ShadowTomorinCardCatalog.Get("WANT_TO_BEING_HUMAN").FailureDisposition);
    }

    [Fact]
    public void CollectionsUseExactWeightsAndOnlyStarStoneIsWildcard()
    {
        IReadOnlyList<(EnemyCollectionDefinition Definition, int Weight)> weighted =
            ShadowTomorinCollectionCatalog.WeightedDefinitions;

        Assert.Equal(6, weighted.Count);
        Assert.Equal(100, weighted.Sum(item => item.Weight));
        Assert.Equal(ShadowTomorinBalance.BrokenNoteWeight,
            Weight(ShadowTomorinCollectionCatalog.BrokenNoteId));
        Assert.Equal(ShadowTomorinBalance.CrumpledPaperWeight,
            Weight(ShadowTomorinCollectionCatalog.CrumpledPaperId));
        Assert.Equal(ShadowTomorinBalance.MidnightCoffeeWeight,
            Weight(ShadowTomorinCollectionCatalog.MidnightCoffeeId));
        Assert.Equal(ShadowTomorinBalance.ColdRedTeaWeight,
            Weight(ShadowTomorinCollectionCatalog.ColdRedTeaId));
        Assert.Equal(ShadowTomorinBalance.LeftoverBuffetWeight,
            Weight(ShadowTomorinCollectionCatalog.LeftoverBuffetId));
        Assert.Equal(ShadowTomorinBalance.StarStoneWeight,
            Weight(ShadowTomorinCollectionCatalog.StarStoneId));
        Assert.Equal(
            ShadowTomorinCollectionCatalog.StarStoneId,
            Assert.Single(weighted, item => item.Definition.IsEpiphany).Definition.CollectionId);
        return;

        int Weight(string id) => weighted.Single(item => item.Definition.CollectionId == id).Weight;
    }

    [Theory]
    [InlineData(EnemyCardPhase.Phase1, 100, 0)]
    [InlineData(EnemyCardPhase.Phase2, 100, 1)]
    [InlineData(EnemyCardPhase.Phase3, 100, 2)]
    public void PhaseRulesExposeExactWeightsAndComposeLimits(
        EnemyCardPhase phase,
        int totalWeight,
        int maxCompose)
    {
        EnemyCardPlanningRules rules = ShadowTomorinRules.ForPhase(phase);

        Assert.Equal(totalWeight, rules.WeightedRecipes.Sum(recipe => recipe.Weight));
        Assert.Equal(ShadowTomorinBalance.MaxCandidateAttempts, rules.MaxCandidateAttempts);
        Assert.Equal(ShadowTomorinBalance.StaticLocks(phase), rules.StaticLocks);
        Assert.Equal(ShadowTomorinBalance.FullLocks(phase), rules.FullLocks);
        Assert.All(rules.WeightedRecipes,
            recipe => Assert.Equal(maxCompose, recipe.Recipe.Constraints.MaxComposeSources));
        if (phase == EnemyCardPhase.Phase3)
        {
            Assert.All(rules.WeightedRecipes, recipe =>
            {
                Assert.Equal(1, recipe.Recipe.Constraints.MaxImmediateAttackComposeSources);
                Assert.Equal(1, recipe.Recipe.Constraints.MaxComposeSourcesProducingImmediateAttack);
            });
        }
    }

    [Fact]
    public void NonComposeMetricsHardExcludeComposeDefinitions()
    {
        foreach (EnemyCardPhase phase in new[] { EnemyCardPhase.Phase2, EnemyCardPhase.Phase3 })
        {
            IEnumerable<EnemyActionRecipe> recipes = ShadowTomorinRules.ForPhase(phase)
                .WeightedRecipes
                .Where(weighted => weighted.Recipe.Metric != EnemyActionMetric.Compose)
                .Select(weighted => weighted.Recipe);

            foreach (EnemyActionSlotRule slot in recipes.SelectMany(recipe => recipe.Slots))
            {
                IReadOnlySet<EnemyCardId> allowed = Assert.IsAssignableFrom<IReadOnlySet<EnemyCardId>>(
                    slot.AllowedDefinitionIds);
                Assert.DoesNotContain(allowed, cardId =>
                    ShadowTomorinCardCatalog.AllDefinitions[cardId].MaterialRequests.Any(request =>
                        request.PaymentKind == EnemyMaterialPaymentKind.Compose));
            }
        }
    }

    [Fact]
    public void RegisteredFactoriesAlwaysReturnFreshInstancesUsingCanonicalDisplayModels()
    {
        ShadowTomorinDeck.EnsureRegistered();
        EnemyCardContentDirectory directory = EnemyCardDeckRegistry.GetContentDirectory(ShadowTomorinDeck.DeckId);

        foreach (EnemyCardDefinition definition in ShadowTomorinCardCatalog.AllDefinitions.Values)
        {
            BaseEnemyCard first = directory.CreateDefinition(definition.CardId);
            BaseEnemyCard second = directory.CreateDefinition(definition.CardId);
            Assert.NotSame(first, second);
            Assert.Same(definition.CardModel, first.CardModel);
            Assert.Equal(definition.SemanticFingerprint, first.Definition.SemanticFingerprint);
        }
    }

    [Fact]
    public void FormalComposePlanningResolvesTokenFromShadowDirectory()
    {
        ShadowTomorinDeck.EnsureRegistered();
        EnemyCardContentDirectory directory = EnemyCardDeckRegistry.GetContentDirectory(ShadowTomorinDeck.DeckId);
        List<BaseEnemyCard> phaseCards = EnemyCardDeckRegistry.CreatePhaseDeck(
            ShadowTomorinDeck.DeckId,
            EnemyCardPhase.Phase2);
        BaseEnemyCard source = phaseCards.Single(card =>
            card.CardId == ShadowTomorinCardCatalog.CardId("HITOSHIZUKU"));
        BaseEnemyCard material = phaseCards.First(card =>
            card.CardId == ShadowTomorinCardCatalog.CardId("TOMORIN_PUNCH"));
        EnemyPreparedPlanningState transaction = new(
            drawPile: phaseCards.Except([source, material]),
            currentCards: [source, material],
            retainedCards: [],
            discardPile: [],
            exhaustPile: [],
            collectionInventory: new EnemyCollectionInventory(),
            nextGeneratedCardSequence: 0,
            contentDirectory: directory,
            activePhase: EnemyCardPhase.Phase2);

        PreparedEnemyCardSource planned = new EnemyPreparedResolutionPlanner().PlanSource(
            source,
            maximumAttempts: 1,
            transaction,
            new EnemyCardRandomSource(_ => 0),
            ShadowTomorinRules.ForPhase(EnemyCardPhase.Phase2).StepLimit);

        PreparedComposeResultStep compose = Assert.Single(Assert.Single(planned.Units).OrderedSteps
            .OfType<PreparedComposeResultStep>());
        EnemyCardId expectedTokenId = ShadowTomorinCardCatalog.CardId("HITOSHIZUKU_TOKEN");
        Assert.Equal(expectedTokenId, compose.ResultCardId);
        BaseEnemyCard generated = Assert.Single(transaction.DiscardPile, card => card.CardId == expectedTokenId);
        Assert.Same(ShadowTomorinCardCatalog.Get("HITOSHIZUKU_TOKEN").CardModel, generated.CardModel);
        Assert.Equal(EnemyCardPhase.Phase2, generated.SourcePhase);
    }

    [Fact]
    public void DeterministicSeedMatrixRespectsPhaseLocksMetricsAndComposeConstraints()
    {
        ShadowTomorinDeck.EnsureRegistered();
        foreach (EnemyCardPhase phase in new[]
                 {
                     EnemyCardPhase.Phase1,
                     EnemyCardPhase.Phase2,
                     EnemyCardPhase.Phase3
                 })
        {
            EnemyCardPlanningRules rules = ShadowTomorinRules.ForPhase(phase);
            HashSet<EnemyActionMetric> observedMetrics = [];
            foreach (int seed in Enumerable.Range(0, 256))
            {
                SeededIndexSelector selector = new(seed, phase);
                EnemyActionMetricPlanner planner = new(rules, new EnemyCardScoreCalculator());
                EnemyCardCombatState firstState = CreatePhaseState(phase, selector);
                PreparedEnemyCardAction first = PrepareWithSeedContext(
                    firstState,
                    planner,
                    selector,
                    phase,
                    seed,
                    actionOrdinal: 1);
                ValidateAction(first, rules, phase);
                observedMetrics.Add(first.Metric);

                EnemyCardCombatState secondState = CreatePhaseState(phase, selector);
                typeof(EnemyCardCombatState).GetProperty(nameof(EnemyCardCombatState.LastMetric))!
                    .SetValue(secondState, first.Metric);
                PreparedEnemyCardAction second = PrepareWithSeedContext(
                    secondState,
                    planner,
                    selector,
                    phase,
                    seed,
                    actionOrdinal: 2);
                ValidateAction(second, rules, phase);
                observedMetrics.Add(second.Metric);
                Assert.NotEqual(first.Metric, second.Metric);
            }

            EnemyActionMetric[] eligibleMetrics = rules.WeightedRecipes
                .Select(weighted => weighted.Recipe.Metric)
                .Distinct()
                .ToArray();
            Assert.All(eligibleMetrics, metric => Assert.Contains(metric, observedMetrics));
        }
    }

    private static EnemyCardCombatState CreatePhaseState(
        EnemyCardPhase phase,
        SeededIndexSelector selector)
    {
        EnemyCardCombatState state = EnemyCardDeckRegistry.CreateCombatState(ShadowTomorinDeck.DeckId);
        EnemyCardContentDirectory directory = EnemyCardDeckRegistry.GetContentDirectory(ShadowTomorinDeck.DeckId);
        for (int phaseValue = (int)EnemyCardPhase.Phase2;
             phaseValue <= (int)phase;
             phaseValue++)
        {
            EnemyCardPhase nextPhase = (EnemyCardPhase)phaseValue;
            state.RequestPhase(nextPhase);
            state.ApplyPhaseTransition(state.BuildPhaseTransitionCandidate(
                directory.GetPhase(nextPhase),
                new EnemyCardRandomSource(selector.NextIndex)));
        }

        return state;
    }

    private static PreparedEnemyCardAction Prepare(
        EnemyCardCombatState state,
        EnemyActionMetricPlanner planner,
        SeededIndexSelector selector,
        EnemyCardPhase phase) =>
        planner.Prepare(
            state,
            new EnemyPlanningContext(
                new EnemyCardRandomSource(selector.NextIndex),
                createProjectionInput: (authoritativeState, action, initialState, stepLimit) =>
                    CreateSeedMatrixProjectionInput(
                        authoritativeState,
                        action,
                        initialState,
                        stepLimit,
                        phase)));

    private static PreparedEnemyCardAction PrepareWithSeedContext(
        EnemyCardCombatState state,
        EnemyActionMetricPlanner planner,
        SeededIndexSelector selector,
        EnemyCardPhase phase,
        int seed,
        int actionOrdinal)
    {
        try
        {
            return Prepare(state, planner, selector, phase);
        }
        catch (Exception exception)
        {
            throw new InvalidOperationException(
                $"Phase={phase}, Seed={seed}, Action={actionOrdinal}: {exception.Message}",
                exception);
        }
    }

    private static EnemyActionProjectionInput CreateSeedMatrixProjectionInput(
        EnemyCardCombatState state,
        PreparedEnemyCardAction action,
        EnemyProjectionInitialState initialState,
        int stepLimit,
        EnemyCardPhase phase)
    {
        Dictionary<string, decimal> enemyPowers = new(initialState.EnemyPowers, StringComparer.Ordinal);
        if (phase == EnemyCardPhase.Phase3)
        {
            // Phase 3 is entered after the resource-building phase; keep the fresh-state
            // matrix legal for WantToBeingHuman while retaining the real migrated card zones.
            string heartWallId = typeof(AtFieldPower).FullName ?? typeof(AtFieldPower).Name;
            enemyPowers[heartWallId] = 4m;
        }

        EnemyProjectionInitialState accruedState = new(
            initialState.ActivePhase,
            initialState.EnemyBlock,
            enemyPowers,
            initialState.TargetPowers,
            initialState.Cards,
            initialState.AvailableCollections,
            initialState.ConsumedCollections);
        EnemyCardContentDirectory directory = EnemyCardDeckRegistry.GetContentDirectory(state.DeckId);
        int initialTemplateCount = directory.GetPhase(action.Phase).InitialSourceInstanceCount;
        return new EnemyActionProjectionInput(
            [new EnemySimulationTarget("SEED_MATRIX_TARGET", decimal.One, decimal.One)],
            stepLimit,
            initialState: accruedState,
            contentDirectory: directory,
            riskContext: new EnemyActionRiskContext(action.Phase, initialTemplateCount, directory));
    }

    private static void ValidateAction(
        PreparedEnemyCardAction action,
        EnemyCardPlanningRules rules,
        EnemyCardPhase phase)
    {
        EnemySoftLockDiagnostic diagnostic = action.SoftLockDiagnostic;
        Assert.True(diagnostic.ProjectionIsComplete);
        if (diagnostic.CommitMode == EnemyCandidateCommitMode.WithinLocks)
        {
            EnemySoftLockLimits limits = ShadowTomorinBalance.FullLocks(phase);
            Assert.True(diagnostic.FullScore.AttackRisk <= limits.Attack);
            Assert.True(diagnostic.FullScore.TotalRisk <= limits.Total);
        }
        else
        {
            Assert.Equal(EnemyCandidateCommitMode.ForcedOverLock, diagnostic.CommitMode);
        }

        EnemyCandidateConstraints constraints = rules.WeightedRecipes
            .Single(weighted => weighted.Recipe.Metric == action.Metric)
            .Recipe
            .Constraints;
        BaseEnemyCard[] composeSources = action.Sources
            .Select(source => source.SourceCard)
            .Where(card => card.Definition.Tags.HasFlag(EnemyCardTag.Compose))
            .ToArray();
        Assert.True(composeSources.Length <= constraints.MaxComposeSources);
        int immediateAttackComposeSources = composeSources.Count(card =>
            card.Definition.TokenTiming == EnemyCardTokenTiming.Immediate &&
            card.Definition.ComposeResultCardId is EnemyCardId resultId &&
            ShadowTomorinCardCatalog.AllDefinitions[resultId].Tags.HasFlag(EnemyCardTag.Attack));
        Assert.True(immediateAttackComposeSources <= constraints.MaxImmediateAttackComposeSources);
        Assert.True(immediateAttackComposeSources <= constraints.MaxComposeSourcesProducingImmediateAttack);
        if (composeSources.Length > 1)
        {
            Assert.Contains(composeSources, card =>
                card.Definition.TokenTiming == EnemyCardTokenTiming.RetainedNextTurn);
        }
    }

    private sealed class SeededIndexSelector
    {
        private ulong _state;

        public SeededIndexSelector(int seed, EnemyCardPhase phase)
        {
            _state = unchecked((ulong)(seed + 1) * 0x9E3779B97F4A7C15UL) ^ (ulong)phase;
        }

        public int NextIndex(int count)
        {
            if (count <= 0)
            {
                throw new ArgumentOutOfRangeException(nameof(count));
            }

            _state = unchecked(_state * 6364136223846793005UL + 1442695040888963407UL);
            return (int)((_state >> 32) % (uint)count);
        }
    }

    private static void AssertPhaseCounts(
        EnemyCardPhase phase,
        params (string Suffix, int Count)[] expected)
    {
        IReadOnlyList<EnemyCardDefinition> actual = ShadowTomorinCardCatalog.GetPhaseDefinitions(phase);
        Assert.Equal(expected.Sum(item => item.Count), actual.Count);
        foreach ((string suffix, int count) in expected)
        {
            EnemyCardId id = ShadowTomorinCardCatalog.CardId(suffix);
            Assert.Equal(count, actual.Count(definition => definition.CardId == id));
        }
    }
}
