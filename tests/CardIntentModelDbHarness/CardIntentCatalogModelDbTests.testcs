using System.Reflection;
using MegaCrit.Sts2.Core.Models;
using MegaCrit.Sts2.Core.Models.Powers;
using STS2_Tomorin_Mod.Cards;
using STS2_Tomorin_Mod.Cards.Collections;
using STS2_Tomorin_Mod.Enemy.CardIntents;
using STS2_Tomorin_Mod.Enemy.CardIntents.Intents;
using STS2_Tomorin_Mod.Enemy.CardIntents.Presentation;
using STS2_Tomorin_Mod.Enemy.CardIntents.Test;
using STS2_Tomorin_Mod.Powers;
using Xunit;

namespace STS2_Tomorin_Mod.Tests.CardIntents;

public sealed class CardIntentCatalogModelDbTests
{
    private static readonly EnemyCardDeckId TimelineDeckId =
        new("STS2_TOMORIN_MOD:MODELDB_COLLECTION_TIMELINE_TEST");

    [Fact]
    public void CatalogAndCollectionResolverReuseRegisteredCardModelsAfterModelDbInitialization()
    {
        Type[] cardTypes =
        [
            typeof(PrideManSaki),
            typeof(Haruhikage),
            typeof(SongOfBeHuman),
            typeof(NamelessPaper),
            typeof(HitoshizukuToken),
            typeof(Hitoshizuku),
            typeof(HeartBeat),
            typeof(DuckAndCover),
            typeof(BuildAtField),
            typeof(TomorinPunch),
            typeof(UnwantedSixth),
            typeof(PoetryOrLyrics),
            typeof(WantBeYourGod),
            typeof(WantBeYourGodToken),
            typeof(Mayoiuta),
            typeof(MayoiutaToken),
            typeof(Senzaihyoumei),
            typeof(SenzaihyoumeiToken),
            typeof(SingFullPower),
            typeof(WantToBeingHuman),
            typeof(SorrowfulRain),
            typeof(Adayume),
            typeof(NameOfTear),
            typeof(StrikeTomorin),
            typeof(WhyPlayHaruhikage),
            typeof(ThisNoNeed),
            typeof(DefendTomorin),
            typeof(AtField),
            typeof(HopeOnTheVoice),
            typeof(CannotBeingHuman),
            typeof(Woodlouse),
            typeof(BrokenNote),
            typeof(ColdRedTea),
            typeof(CrumpledPaper),
            typeof(LeftoverBuffet),
            typeof(MidnightCoffee),
            typeof(StarStone),
            typeof(Utakotoba),
            typeof(UtakotobaToken)
        ];

        ModelDb.ResetForTest();
        ModelDb.Init(cardTypes);
        IReadOnlyDictionary<Type, CardModel> registeredCards =
            new Dictionary<Type, CardModel>
            {
                [typeof(PrideManSaki)] = ModelDb.Card<PrideManSaki>(),
                [typeof(Haruhikage)] = ModelDb.Card<Haruhikage>(),
                [typeof(SongOfBeHuman)] = ModelDb.Card<SongOfBeHuman>(),
                [typeof(NamelessPaper)] = ModelDb.Card<NamelessPaper>(),
                [typeof(HitoshizukuToken)] = ModelDb.Card<HitoshizukuToken>(),
                [typeof(Hitoshizuku)] = ModelDb.Card<Hitoshizuku>(),
                [typeof(HeartBeat)] = ModelDb.Card<HeartBeat>(),
                [typeof(DuckAndCover)] = ModelDb.Card<DuckAndCover>(),
                [typeof(BuildAtField)] = ModelDb.Card<BuildAtField>(),
                [typeof(TomorinPunch)] = ModelDb.Card<TomorinPunch>(),
                [typeof(UnwantedSixth)] = ModelDb.Card<UnwantedSixth>(),
                [typeof(PoetryOrLyrics)] = ModelDb.Card<PoetryOrLyrics>(),
                [typeof(WantBeYourGod)] = ModelDb.Card<WantBeYourGod>(),
                [typeof(WantBeYourGodToken)] = ModelDb.Card<WantBeYourGodToken>(),
                [typeof(Mayoiuta)] = ModelDb.Card<Mayoiuta>(),
                [typeof(MayoiutaToken)] = ModelDb.Card<MayoiutaToken>(),
                [typeof(Senzaihyoumei)] = ModelDb.Card<Senzaihyoumei>(),
                [typeof(SenzaihyoumeiToken)] = ModelDb.Card<SenzaihyoumeiToken>(),
                [typeof(SingFullPower)] = ModelDb.Card<SingFullPower>(),
                [typeof(WantToBeingHuman)] = ModelDb.Card<WantToBeingHuman>(),
                [typeof(SorrowfulRain)] = ModelDb.Card<SorrowfulRain>(),
                [typeof(Adayume)] = ModelDb.Card<Adayume>(),
                [typeof(NameOfTear)] = ModelDb.Card<NameOfTear>(),
                [typeof(StrikeTomorin)] = ModelDb.Card<StrikeTomorin>(),
                [typeof(WhyPlayHaruhikage)] = ModelDb.Card<WhyPlayHaruhikage>(),
                [typeof(ThisNoNeed)] = ModelDb.Card<ThisNoNeed>(),
                [typeof(DefendTomorin)] = ModelDb.Card<DefendTomorin>(),
                [typeof(AtField)] = ModelDb.Card<AtField>(),
                [typeof(HopeOnTheVoice)] = ModelDb.Card<HopeOnTheVoice>(),
                [typeof(CannotBeingHuman)] = ModelDb.Card<CannotBeingHuman>(),
                [typeof(Woodlouse)] = ModelDb.Card<Woodlouse>(),
                [typeof(BrokenNote)] = ModelDb.Card<BrokenNote>(),
                [typeof(ColdRedTea)] = ModelDb.Card<ColdRedTea>(),
                [typeof(CrumpledPaper)] = ModelDb.Card<CrumpledPaper>(),
                [typeof(LeftoverBuffet)] = ModelDb.Card<LeftoverBuffet>(),
                [typeof(MidnightCoffee)] = ModelDb.Card<MidnightCoffee>(),
                [typeof(StarStone)] = ModelDb.Card<StarStone>()
            };

        IReadOnlyCollection<EnemyCardDefinition> definitions =
            CardIntentTestCardCatalog.AllDefinitions.Values.ToArray();

        Assert.Equal(17, definitions.Count);
        Assert.All(definitions, definition =>
            Assert.Same(registeredCards[definition.CardModel.GetType()], definition.CardModel));

        ShadowTomorinDeck.EnsureRegistered();
        IReadOnlyCollection<EnemyCardDefinition> shadowDefinitions =
            ShadowTomorinCardCatalog.AllDefinitions.Values.ToArray();
        Assert.NotEmpty(shadowDefinitions);
        Assert.All(shadowDefinitions, definition =>
            Assert.Same(registeredCards[definition.CardModel.GetType()], definition.CardModel));
        Assert.DoesNotContain(shadowDefinitions, definition =>
            definition.CardModel is Utakotoba or UtakotobaToken);
        IReadOnlyList<string> shadowAssetPaths = EnemyCardDeckRegistry.GetAssetPaths(ShadowTomorinDeck.DeckId);
        Assert.NotEmpty(shadowAssetPaths);
        MethodInfo getCardModelAssetPaths = typeof(EnemyCardDeckRegistry).GetMethod(
            "GetCardModelAssetPaths",
            BindingFlags.NonPublic | BindingFlags.Static) ??
            throw new InvalidOperationException("敌人牌组注册表缺少卡牌资源枚举入口。");
        string[] forbiddenUtakotobaPaths = new CardModel[]
            {
                ModelDb.Card<Utakotoba>(),
                ModelDb.Card<UtakotobaToken>()
            }
            .SelectMany(model => Assert.IsAssignableFrom<IEnumerable<string>>(
                getCardModelAssetPaths.Invoke(null, [model])))
            .Distinct(StringComparer.Ordinal)
            .ToArray();
        Assert.DoesNotContain(shadowAssetPaths, forbiddenUtakotobaPaths.Contains);
        Assert.All(ShadowTomorinCollectionCatalog.Catalog.Definitions, definition =>
            Assert.Same(registeredCards[definition.CardModelType], definition.ResolveCardModel()));

        IReadOnlyCollection<EnemyCollectionDefinition> collectionDefinitions =
            CardIntentTestCollectionCatalog.Catalog.Definitions;
        Assert.Equal(6, collectionDefinitions.Count);
        Assert.All(collectionDefinitions, definition =>
            Assert.Same(registeredCards[definition.CardModelType], definition.ResolveCardModel()));

        FieldInfo timelineAssetPathsField = typeof(CardListIntent).GetField(
            "TimelineCardAssetPaths",
            BindingFlags.NonPublic | BindingFlags.Static) ??
            throw new InvalidOperationException("CardListIntent 缺少时间线资源缓存字段。");
        string[] timelineAssetPaths = Assert.IsType<string[]>(timelineAssetPathsField.GetValue(null));
        Assert.NotEmpty(timelineAssetPaths);

        EnemyCardDefinition attackDefinition = CardIntentTestCardCatalog.AllDefinitions.Values
            .Single(definition => definition.CardId.Value.EndsWith("_ATTACK", StringComparison.Ordinal));
        if (!EnemyCardDeckRegistry.IsRegistered(TimelineDeckId))
        {
            EnemyCardDeckRegistry.Register(
                TimelineDeckId,
                [() => CardIntentTestCardCatalog.CreateCard(attackDefinition.CardId)]);
        }

        BaseEnemyCard consumer = Assert.Single(
            EnemyCardDeckRegistry.CreateCombatState(TimelineDeckId).DrawPile);
        const string collectionInstanceId = "COLLECTION:MODELDB:0";
        PreparedEnemyCardUnitPlan unit = new(
            consumer.InstanceKey,
            consumer.InstanceKey,
            consumer.CardId,
            0,
            EnemyPreparedExecutionMode.Normal,
            [],
            [new PreparedConsumedCollectionStep(
                collectionInstanceId,
                CardIntentTestCollectionCatalog.BrokenNoteId,
                [])]);
        PreparedEnemyCardAction action = new(
            EnemyActionMetric.Attack,
            [],
            [consumer],
            [new PreparedEnemyCardSource(consumer, 1, [unit])],
            new EnemySoftLockDiagnostic(new EnemyCardScore(0m, 0m), 0m, 0m, 1, 0, false));

        EnemyIntentTimelineEntry collectionEntry = Assert.Single(
            EnemyIntentTimelineBuilder.Build(action).Entries,
            entry => entry.Role == EnemyIntentTimelineRole.ConsumedCollection);
        Assert.Same(ModelDb.Card<BrokenNote>(), collectionEntry.CardModel);

        EnemyCollectionEffectProgram brokenNoteProgram = EnemyCollectionEffectResolver.GetRequired(
            CardIntentTestCollectionCatalog.Catalog.GetRequired(CardIntentTestCollectionCatalog.BrokenNoteId));
        EnemyCollectionEffectProgram coldRedTeaProgram = EnemyCollectionEffectResolver.GetRequired(
            CardIntentTestCollectionCatalog.Catalog.GetRequired(CardIntentTestCollectionCatalog.ColdRedTeaId));

        Assert.Equal(5m, Assert.IsType<EnemyBlockEffect>(brokenNoteProgram.DirectEffects[0]).Block);
        Assert.Equal(
            1m,
            Assert.IsType<EnemySelfPowerEffect<BrokenNotePower>>(brokenNoteProgram.DirectEffects[1]).Amount);
        Assert.Equal(
            2m,
            Assert.IsType<EnemyAllPlayersPowerEffect<WeakPower>>(coldRedTeaProgram.DirectEffects[0]).Amount);
        Assert.Equal(
            2m,
            Assert.IsType<EnemyAllPlayersPowerEffect<CustomConstrictPower>>(coldRedTeaProgram.DirectEffects[1]).Amount);
    }
}
